взяти біб Памʼять;
взяти біб Реєстр;

простір ПМ {
  структура Назва {
    значення: кд;
  }

  структура СховищеНазв {
    розмір: природне;
    дані: **Назва;
    вмісткість: природне;
  }

  дія створити_сховище_назв() -> *СховищеНазв;
  дія знищити_сховище_назв(сховище: *СховищеНазв);
  дія отримати_назву(сховище: *СховищеНазв, значення: кд) -> *Назва;
  дія отримати_назву_без_копіювання(сховище: *СховищеНазв, значення: кд) -> *Назва;
}

простір ПМ {
  стала ВИДИМІСТЬ_ВНУТРІШНЯ = 1;
  стала ВИДИМІСТЬ_ЗОВНІШНЯ = 3;

  стала ПЛАТФОРМА_ЛІНУКС_ІКС86_64 = 10;
  стала ПЛАТФОРМА_ЛІНУКС_ААРЧ64 = 11;
  стала ПЛАТФОРМА_МАКОС_ІКС86_64 = 20;
  стала ПЛАТФОРМА_МАКОС_ААРЧ64 = 21;
  стала ПЛАТФОРМА_ВІНДОВС_ІКС86_64 = 30;
  стала ПЛАТФОРМА_ВІНДОВС_ААРЧ64 = 31;
  стала ПЛАТФОРМА_ВАСМ32 = 40;
  стала ПЛАТФОРМА_ВАСМ64 = 41;

  структура Модуль;
  структура Інструкція;
  структура Крок;
  структура Стрибок;
  структура Значення;
  структура Тип;

  структура Параметр {
    тип: *Тип;
  }

  структура Параметри {
    розмір: природне;
    дані: *Параметр;
    вмісткість: природне;
  }

  структура Модуль {
    платформа: природне;
    типи: *біб::Реєстр<*Назва, *Тип>;
    глобальні: *біб::Реєстр<*Назва, *Значення>;
    тип_ніщо: *Тип;
    тип_адреса: *Тип;
    тип_логічне: *Тип;
    тип_п8: *Тип;
    тип_п16: *Тип;
    тип_п32: *Тип;
    тип_п64: *Тип;
    тип_ц8: *Тип;
    тип_ц16: *Тип;
    тип_ц32: *Тип;
    тип_ц64: *Тип;
    тип_р32: *Тип;
    тип_р64: *Тип;
    значення_пусто: *Значення;
    значення_так: *Значення;
    значення_ні: *Значення;
