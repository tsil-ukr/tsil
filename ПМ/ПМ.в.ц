  стала ВидТипуІнструкція = 13;
  стала ВидТипуСтруктура = 14;
  стала ВидТипуМасив = 15;

  структура ДаніТипуСтруктура {
    назва: *Назва;
    параметри: Параметри;
    пакована: логічне;
  }

  структура ДаніТипуМасив {
    тип_елемента: *Тип;
    розмір: природне;
  }

  структура ДаніТипуІнструкція {
    параметри: Параметри;
    тип_результату: *Тип;
  }

  структура Тип {
    модуль: *Модуль;
    вид: природне;
    дані: ДаніТипуСтруктура
        | ДаніТипуМасив
        | ДаніТипуІнструкція;
    дані_компіляції: адреса;
  }

  структура Вказівки {
    розмір: природне;
    дані: **Значення;
    вмісткість: природне;
  }

  структура Кроки {
