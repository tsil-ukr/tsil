  стала ВидВказівкиРхРівн = 33;
  стала ВидВказівкиРхНеРівн = 34;
  стала ВидВказівкиЗнБілш = 35;
  стала ВидВказівкиРхБілш = 36;
  стала ВидВказівкиЗнМенш = 37;
  стала ВидВказівкиРхМенш = 38;
  стала ВидВказівкиЗнБілшРівн = 39;
  стала ВидВказівкиРхБілшРівн = 40;
  стала ВидВказівкиЗнМеншРівн = 41;
  стала ВидВказівкиРхМеншРівн = 42;
  стала ВидВказівкиАрфЗсунПрав = 43;
  стала ВидВказівкиВиконати = 100;
  стала ВидВказівкиСтрб = 101;
  стала ВидВказівкиСтрбЯкщо = 102;

  стала ВидВказівкиЗріз = 200; // трунк
  стала ВидВказівкиНлРзш = 201; // зекст
  стала ВидВказівкиЗнРзш = 202; // секст
