  стала ВидВказівкиБзМенш = 10;
  стала ВидВказівкиБзБілшРівн = 11;
  стала ВидВказівкиБзМеншРівн = 12;
  стала ВидВказівкиЗсунЛів = 13;
  стала ВидВказівкиЛогЗсунПрав = 14;
  стала ВидВказівкиДІ = 15;
  стала ВидВказівкиДАБО = 16;
