взяти біб Памʼять;
взяти біб Реєстр;

простір ПМ {
  структура Назва {
    значення: кд;
  }

  структура СховищеНазв {
    розмір: природне;
    дані: **Назва;
    вмісткість: природне;
  }

  дія створити_сховище_назв() -> *СховищеНазв;
  дія знищити_сховище_назв(сховище: *СховищеНазв);
  дія отримати_назву(сховище: *СховищеНазв, значення: кд) -> *Назва;
  дія отримати_назву_без_копіювання(сховище: *СховищеНазв, значення: кд) -> *Назва;
}

