        | п32
        | п64
        | ц8
        | ц16
        | ц32
        | ц64
        | р32
        | р64
        | ДаніЗначенняВказівка
        | ДаніЗначенняГлобальна
        | ДаніЗначенняГлобальнаКонстантаДаних
        | ДаніЗначенняОбʼєкт
        | ДаніЗначенняІнструкція
        | ДаніЗначенняАргумент;
    дані_компіляції: адреса;
  }

  структура Крок {
    інструкція: *Інструкція;
    назва: *Назва;
    вказівки: Вказівки;
    дані_компіляції: адреса;
  }

  дія покласти_параметр(модуль: *Модуль,
                                параметри: *Параметри,
                                параметр: Параметр);

  дія створити_модуль(назва: *Назва,
                              платформа: природне) -> *Модуль;

  дія створити_інструкцію(модуль: *Модуль,
                                  видимість: природне,
                                  назва: *Назва,
                                  параметри: Параметри,
                                  тип_результату: *Тип) -> *Інструкція;

  дія отримати_тип_інструкції(інструкція: *Інструкція) -> *Тип;

  // параметри НЕ буде клоновано
  дія створити_тип_інструкції(модуль: *Модуль,
                                      параметри: Параметри,
