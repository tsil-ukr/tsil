  структура ДаніВказівкиЗначенняІТип {
    значення: *Значення;
    тип: *Тип;
  }

  структура ДаніЗначенняВказівка {
    крок: *Крок;
    вид: природне;
    дані: ДаніОдинарноїВказівки
