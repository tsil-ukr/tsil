  структура Інструкція;
  структура Крок;
  структура Стрибок;
  структура Значення;
  структура Тип;

  структура Параметр {
    тип: *Тип;
  }

  структура Параметри {
    розмір: природне;
    дані: *Параметр;
    вмісткість: природне;
  }

  структура Модуль {
    назва: *Назва;
    платформа: природне;
    типи: *біб::Реєстр<*Назва, *Тип>;
    глобальні: *біб::Реєстр<*Назва, *Значення>;
    тип_ніщо: *Тип;
    тип_адреса: *Тип;
    тип_логічне: *Тип;
    тип_ц8: *Тип;
    тип_ц16: *Тип;
    тип_ц32: *Тип;
    тип_ц64: *Тип;
    тип_р32: *Тип;
    тип_р64: *Тип;
    значення_пусто: *Значення;
    значення_так: *Значення;
    значення_ні: *Значення;
