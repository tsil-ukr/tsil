  стала ПЛАТФОРМА_ІКС86_64_ЕПЛ_ДАРВІН = 20;
  стала ПЛАТФОРМА_ААРЧ64_ЕПЛ_ДАРВІН = 21;
  стала ПЛАТФОРМА_ІКС86_64_ПК_ВІНДОВС_ГНУ = 30;
  стала ПЛАТФОРМА_ААРЧ64_64_ПК_ВІНДОВС_ГНУ = 31;
  стала ПЛАТФОРМА_ІКС86_64_ПК_ВІНДОВС_МСВС = 32;
  стала ПЛАТФОРМА_ААРЧ64_64_ПК_ВІНДОВС_МСВС = 33;
  стала ПЛАТФОРМА_ВАСМ32 = 40;
