        | ДаніВказівкиВидобутиЗначення
        | ДаніВказівкиЗаписати
        | ДаніВказівкиПрочитати
        | ДаніВказівкиВернути
        | ДаніВказівкиСтрибнути
        | ДаніВказівкиСтрибнутиЯкщо
        | ДаніВказівкиЗначенняІТип;
  }

  структура ДаніЗначенняГлобальна {
    видимість: природне;
    назва: *Назва;
  }

  структура ДаніЗначенняГлобальнаКонстантаДаних {
    розмір: природне;
    дані: *п8;
  }

  структура ДаніЗначенняОбʼєкт {
    кількість_аргументів: природне;
    аргументи: **Значення;
  }

  структура ДаніЗначенняАргумент {
    позиція: природне;
    інструкція: *Значення;
  }

  структура ЗначенняАргументів {
    розмір: природне;
    дані: **Значення;
    вмісткість: природне;
  }

  структура ДаніЗначенняІнструкція {
    модуль: *Модуль;
    видимість: природне;
    назва: *Назва;
    тип: *Тип;
    кроки: Кроки;
    значення_аргументів: ЗначенняАргументів;
  }

  структура Значення {
    модуль: *Модуль;
    вид: природне;
    тип: *Тип;
    дані: логічне
        | п8
        | п16
        | п32
        | п64
        | ц8
        | ц16
        | ц32
        | ц64
        | р32
        | р64
        | ДаніЗначенняВказівка
        | ДаніЗначенняГлобальна
        | ДаніЗначенняГлобальнаКонстантаДаних
        | ДаніЗначенняОбʼєкт
        | ДаніЗначенняІнструкція
        | ДаніЗначенняАргумент;
    дані_компіляції: адреса;
  }

  структура Крок {
    інструкція: *Інструкція;
    назва: *Назва;
    вказівки: Вказівки;
    дані_компіляції: адреса;
  }

  дія покласти_параметр(
    модуль: *Модуль,
    параметри: *Параметри,
    параметр: Параметр
