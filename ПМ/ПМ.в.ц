    розмір: природне;
    дані: **Значення;
    вмісткість: природне;
  }

  структура ДаніЗначенняІнструкція {
    модуль: *Модуль;
    видимість: природне;
    назва: *Назва;
    тип: *Тип;
    кроки: Кроки;
