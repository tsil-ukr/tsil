  дія отримати_значення_аргумента_інструкції(інструкція: *Інструкція,
                                                     позиція: природне) -> *Значення;

  дія створити_крок(інструкція: *Інструкція,
                            назва: *Назва) -> *Крок;

  дія перевірити_чи_крок_закінчується_стрибком(крок: *Крок) -> логічне;

  дія створити_структуру(модуль: *Модуль,
                                 назва: *Назва,
                                 параметри: Параметри,
                                 пакована: логічне) -> *Тип;

  // параметри НЕ буде клоновано
  дія заповнити_параметри_структури(тип: *Тип,
                                            параметри: Параметри);

  // аргументи НЕ буде клоновано
