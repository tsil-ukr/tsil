простір біб {
  внутрішня дія виділити<Т>(кількість: природне) -> *Т {
    вернути бібц__виділити(кількість * Т.розмір) як *Т;
  }

  внутрішня дія перевиділити<Т>(значення: *Т, кількість: природне) -> *Т {
    вернути бібц__перевиділити(значення, кількість * Т.розмір) як *Т;
  }

  внутрішня дія звільнити(значення: адреса) {
    бібц__звільнити(значення);
  }
}