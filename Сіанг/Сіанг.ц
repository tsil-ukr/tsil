взяти біб Накопичувач;
взяти визначення ./Сіанг;

простір Сіанг {
  внутрішня дія покласти_ю8(нт: *біб::Накопичувач<п8>, значення: ю8) {
    змінна п: природне = 0;

    поки п < значення.розмір {
      біб::покласти_в_накопичувач<п8>(нт, значення.дані[п]);

      п += 1;
    }
  }

  внутрішня дія покласти_назву_типу(тип: *Тип, нт: *біб::Накопичувач<п8>) {
    якщо тип.вид == ВидТипуВбудований {
      змінна назва = тип.дані як *Назва;

      покласти_ю8(нт, назва.як_ю8());
    }

    якщо тип.вид == ВидТипуСтруктура {
      змінна дані_структури = тип.дані як ДаніТипуСтруктура;

      покласти_ю8(нт, дані_структури.назва.як_ю8());
    }
  }

  дія перетворити_на_код(тіло: *Тіло, вихід: *ю8) {
    змінна нт = біб::зробити_накопичувач<п8>(0);
    змінна п: природне = 0;

    поки п < тіло.типи.розмір {
      змінна тип = тіло.типи.дані[п];

      // ...

      вернути;

      п += 1;
    }

    п = 0;
    поки п < тіло.змінні.розмір {
      змінна дані_змінної = тіло.змінні.дані[п].дані як ДаніЗначенняЗмінна;

      покласти_назву_типу(дані_змінної.тип, нт::адреса);
      покласти_ю8(нт::адреса, ю8" ");
      покласти_ю8(нт::адреса, дані_змінної.назва.як_ю8());
      покласти_ю8(нт::адреса, ю8";\р");

      вернути;

      п += 1;
    }

    п = 0;
    поки п < тіло.функції.розмір {
      змінна дані_функції = тіло.функції.дані[п].дані як ДаніЗначенняФункція;

      покласти_назву_типу(дані_функції.тип_результату, нт::адреса);
      покласти_ю8(нт::адреса, ю8" ");
      покласти_ю8(нт::адреса, дані_функції.назва.як_ю8());
      покласти_ю8(нт::адреса, ю8"(");
      покласти_ю8(нт::адреса, ю8");");

      вернути;

      п += 1;
    }

    п = 0;
    поки п < тіло.елементи.розмір {
      змінна елемент_тіла = тіло.елементи.дані[п];

      якщо елемент_тіла.вид == ВидЕлементаТілаПризначити {
        змінна дані_призначити = елемент_тіла.дані як ДаніЕлементаТілаПризначити;

        покласти_ю8(нт::адреса, дані_призначити.назва.як_ю8());
        покласти_ю8(нт::адреса, ю8" = ");
      } інакше якщо елемент_тіла.вид == ВидЕлементаТілаЗначення {
        змінна значення = елемент_тіла.дані як *Значення;
      }

      п += 1;
    }

    вихід::вміст = ю8 { нт.дані, нт.розмір };
  }
}