взяти біб Накопичувач;
взяти визначення ./Сіанг;

простір Сіанг {
  внутрішня дія покласти_ю8(нт: *біб::Накопичувач<п8>, значення: ю8) {
    змінна п: природне = 0;

    поки п < значення.розмір {
      біб::покласти_в_накопичувач<п8>(нт, значення.дані[п]);

      п += 1;
    }
  }

  внутрішня дія покласти_тип(тип: *Тип, нт: *біб::Накопичувач<п8>) {
    якщо тип.вид == ВидТипуНазва {
      змінна назва = тип.дані як *Назва;

      покласти_ю8(нт, назва.як_ю8());

      вернути;
    }

    якщо тип.вид == ВидТипуАдреса {
      змінна тип_адреси = тип.дані як *Тип;

      покласти_тип(тип_адреси, нт);
      покласти_ю8(нт, ю8"*");

      вернути;
    }
  }

  внутрішня дія покласти_відступ(нт: *біб::Накопичувач<п8>, розмір: природне) {
    змінна п: природне = 0;

    поки п < розмір {
      покласти_ю8(нт, ю8" ");
      покласти_ю8(нт, ю8" ");

      п += 1;
    }
  }

  внутрішня дія перетворити_на_код_(файл: *Файл, тіло: *Тіло, нт: *біб::Накопичувач<п8>, відступ: природне) {
    змінна п: природне;
    змінна пп: природне;

    п = 0;
    поки п < тіло.структури.розмір {
      змінна структура_ = тіло.структури.дані[п];

      покласти_відступ(нт, відступ);
      покласти_ю8(нт, файл.СІАНГ_ТАЙПДЕФ);
      покласти_ю8(нт, ю8" ");
      покласти_ю8(нт, файл.СІАНГ_СТРАКТ);
      покласти_ю8(нт, ю8" ");
      покласти_ю8(нт, структура_.назва.як_ю8());
      покласти_ю8(нт, ю8" ");
      покласти_ю8(нт, структура_.назва.як_ю8());
      покласти_ю8(нт, ю8";\р");

      п += 1;
    }

    п = 0;
    поки п < тіло.структури.розмір {
      змінна структура_ = тіло.структури.дані[п];

      покласти_відступ(нт, відступ);
      покласти_ю8(нт, файл.СІАНГ_СТРАКТ);
      покласти_ю8(нт, ю8" ");
      покласти_ю8(нт, структура_.назва.як_ю8());

      якщо структура_.параметри.розмір == 0 {
        покласти_ю8(нт, ю8";\р");
      } інакше {
        покласти_ю8(нт, ю8" {\р");

        пп = 0;
        поки пп < структура_.параметри.розмір {
          змінна параметр = структура_.параметри.дані[пп];
          покласти_відступ(нт, відступ + 1);
          покласти_тип(параметр.тип, нт);
          покласти_ю8(нт, ю8" ");
          покласти_ю8(нт, параметр.назва.як_ю8());
          покласти_ю8(нт, ю8";\р");

          пп += 1;
        }

        покласти_відступ(нт, відступ);
        покласти_ю8(нт, ю8"};\р");
      }

      п += 1;
    }

    п = 0;
    поки п < тіло.змінні.розмір {
      змінна змінна_ = тіло.змінні.дані[п];

      покласти_відступ(нт, відступ);
      покласти_тип(змінна_.тип, нт);
      покласти_ю8(нт, ю8" ");
      покласти_ю8(нт, змінна_.назва.як_ю8());
      покласти_ю8(нт, ю8";\р");

      п += 1;
    }

    п = 0;
    поки п < тіло.функції.розмір {
      змінна функція = тіло.функції.дані[п];

      покласти_відступ(нт, відступ);
      якщо функція.статична {
        покласти_ю8(нт, файл.СІАНГ_СТАТІК);
        покласти_ю8(нт, ю8" ");
      }
      покласти_тип(функція.тип_результату, нт);
      покласти_ю8(нт, ю8" ");
      покласти_ю8(нт, функція.назва.як_ю8());
      покласти_ю8(нт, ю8"(");
      покласти_ю8(нт, ю8");\р");

      п += 1;
    }

    п = 0;
    поки п < тіло.функції.розмір {
      змінна функція = тіло.функції.дані[п];

      якщо функція.має_тіло {
        покласти_відступ(нт, відступ);
        якщо функція.статична {
          покласти_ю8(нт, файл.СІАНГ_СТАТІК);
          покласти_ю8(нт, ю8" ");
        }
        покласти_тип(функція.тип_результату, нт);
        покласти_ю8(нт, ю8" ");
        покласти_ю8(нт, функція.назва.як_ю8());
        покласти_ю8(нт, ю8"(");
        покласти_ю8(нт, ю8") {\р");
        перетворити_на_код_(файл, функція.тіло, нт, відступ + 1);
        покласти_ю8(нт, ю8"}\р");
      }

      п += 1;
    }

    // п = 0;
    // поки п < тіло.елементи.розмір {
    //   змінна елемент_тіла = тіло.елементи.дані[п];

    //   якщо елемент_тіла.вид == ВидЕлементаТілаПризначити {
    //     змінна дані_призначити = елемент_тіла.дані як ДаніЕлементаТілаПризначити;

    //     покласти_ю8(нт, дані_призначити.назва.як_ю8());
    //     покласти_ю8(нт, ю8" = ");
    //   } інакше якщо елемент_тіла.вид == ВидЕлементаТілаВираз {
    //     змінна вираз = елемент_тіла.дані як *Вираз;
    //   }

    //   п += 1;
    // }
  }

  дія перетворити_на_код(файл: *Файл, тіло: *Тіло, вихід: *ю8) {
    змінна нт = біб::зробити_накопичувач<п8>(0);

    перетворити_на_код_(файл, тіло, нт::адреса, 0);

    вихід::вміст = ю8 { нт.дані, нт.розмір };
  }
}