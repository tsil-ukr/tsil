взяти біб Памʼять;
взяти біб Друк;
взяти визначення СховищеНазв;

простір Сіанг {
  структура Тип;
  структура Файл;
  структура Тіло;
  структура Вираз;

  синонім Назва = СховищеНазв::Назва;

  структура ПараметрСтруктури {
    тип: *Тип;
    назва: *Назва;
  }

  структура ПараметрФункції {
    тип: *Тип;
    назва: *Назва;
  }

  стала ВидТипуНазва = 1;
  стала ВидТипуАдреса = 2;

  структура Тип {
    вид: природне;
    дані: *Назва | *Тип;
  }

  структура Структура {
    назва: *Назва;
    параметри: біб::Накопичувач<ПараметрСтруктури>;

    внутрішня дія покласти_параметр(я: *Я, тип: *Тип, назва: *Назва) {
      змінна параметр: ПараметрСтруктури;
      параметр.тип = тип;
      параметр.назва = назва;

      біб::покласти_в_накопичувач<ПараметрСтруктури>(
        я.параметри::адреса,
        параметр
      );
    }
  }

  структура Змінна {
    тип: *Тип;
    назва: *Назва;
  }

  структура Аллока {
    тип: *Тип;
    назва_змінної: *Назва;
    назва: *Назва;
  }

  структура Функція {
    статична: логічне;
    тип_результату: *Тип;
    назва: *Назва;
    параметри: біб::Накопичувач<ПараметрФункції>;
    тіло: *Тіло;
    має_тіло: логічне;
  }

  стала ВидВиразуНазва = 1;
  стала ВидВиразуДодати = 2;
  стала ВидВиразуВідняти = 3;
  стала ВидВиразуПомножити = 4;
  стала ВидВиразуПоділити = 5;
  стала ВидВиразуВідʼємне = 6;

  структура ДаніВиразуДодати {
    ліво: *Вираз;
    право: *Вираз;
  }

  структура ДаніВиразуВідняти {
    ліво: *Вираз;
    право: *Вираз;
  }

  структура ДаніВиразуПомножити {
    ліво: *Вираз;
    право: *Вираз;
  }

  структура ДаніВиразуПоділити {
    ліво: *Вираз;
    право: *Вираз;
  }

  структура ДаніВиразуВідʼємне {
    значення: *Вираз;
  }

  структура Вираз {
    вид: природне;
    дані: *Назва
        | ДаніВиразуДодати
        | ДаніВиразуВідняти
        | ДаніВиразуПомножити
        | ДаніВиразуПоділити
        | ДаніВиразуВідʼємне;
  }

  стала ВидЕлементаТілаПризначити = 1;
  стала ВидЕлементаТілаВираз = 2;

  структура ДаніЕлементаТілаПризначити {
    назва: *Назва;
    значення: *Вираз;
  }

  структура ЕлементТіла {
    вид: природне;
    дані: ДаніЕлементаТілаПризначити
        | *Вираз;
  }

  структура БазовийБлок {
    назва: *Назва;
    аллоки: біб::Накопичувач<*Аллока>;
    елементи: біб::Накопичувач<*ЕлементТіла>;

    внутрішня дія створити_вираз_назва(назва: *Назва) -> *Вираз {
      змінна вираз = біб::виділити<Вираз>(1);
      вираз.вид = ВидВиразуНазва;
      вираз.дані = назва;

      вернути вираз;
    }

    внутрішня дія створити_аллока(я: *Я, тип: *Тип, назва: *Назва) -> *Вираз {
      змінна з = біб::виділити<Аллока>(1);
      з.тип = тип;
      з.назва_змінної = назва; // потім: виправити
      з.назва = назва;

      біб::покласти_в_накопичувач<*Аллока>(
        я.аллоки::адреса,
        з
      );

      вернути я.створити_вираз_назва(назва);
    }

    внутрішня дія створити_додати(я: *Я, тип: *Тип, назва: *Назва) -> *Вираз {
      змінна з = біб::виділити<Аллока>(1);
      з.тип = тип;
      з.назва_змінної = назва; // потім: виправити
      з.назва = назва;

      біб::покласти_в_накопичувач<*Аллока>(
        я.аллоки::адреса,
        з
      );

      вернути я.створити_вираз_назва(назва);
    }

    внутрішня дія створити_елемент_тіла_призначити(я: *Я, назва: *Назва, значення: *Вираз) {
      змінна е = біб::виділити<ЕлементТіла>(1);
      е.вид = ВидЕлементаТілаПризначити;
      е.дані = ДаніЕлементаТілаПризначити { назва, значення };

      біб::покласти_в_накопичувач<*ЕлементТіла>(
        я.елементи::адреса,
        е
      );
    }

    внутрішня дія створити_елемент_тіла_вираз(я: *Я, вираз: *Вираз) {
      змінна е = біб::виділити<ЕлементТіла>(1);
      е.вид = ВидЕлементаТілаВираз;
      е.дані = вираз;

      біб::покласти_в_накопичувач<*ЕлементТіла>(
        я.елементи::адреса,
        е
      );
    }
  }

  внутрішня дія створити_тіло() -> *Тіло;

  структура Тіло {
    структури: біб::Накопичувач<*Структура>;
    змінні: біб::Накопичувач<*Змінна>;
    функції: біб::Накопичувач<*Функція>;
    базові_блоки: біб::Накопичувач<*БазовийБлок>;

    внутрішня дія створити_тип_назва(назва: *Назва) -> *Тип {
      змінна тип = біб::виділити<Тип>(1);
      тип.вид = ВидТипуНазва;
      тип.дані = назва;

      вернути тип;
    }

    внутрішня дія створити_тип_адреса(тип_адреси: *Тип) -> *Тип {
      змінна тип = біб::виділити<Тип>(1);
      тип.вид = ВидТипуАдреса;
      тип.дані = тип_адреси;

      вернути тип;
    }

    внутрішня дія створити_структуру(я: *Я, назва: *Назва, дані_параметрів: *ПараметрСтруктури, розмір_параметрів: природне) -> *Структура {
      змінна с = біб::виділити<Структура>(1);
      с.назва = назва;
      с.параметри.дані = дані_параметрів;
      с.параметри.розмір = розмір_параметрів;
      с.параметри.вмісткість = розмір_параметрів;

      біб::покласти_в_накопичувач<*Структура>(
        я.структури::адреса,
        с
      );

      вернути с;
    }

    внутрішня дія створити_змінну(я: *Я, тип: *Тип, назва: *Назва) -> *Назва {
      змінна з = біб::виділити<Змінна>(1);
      з.тип = тип;
      з.назва = назва;

      біб::покласти_в_накопичувач<*Змінна>(
        я.змінні::адреса,
        з
      );

      вернути назва;
    }

    внутрішня дія створити_функцію(я: *Я, тип_результату: *Тип, назва: *Назва, дані_параметрів: *ПараметрФункції, розмір_параметрів: природне) -> *Функція {
      змінна ф = біб::виділити<Функція>(1);
      ф.статична = ні;
      ф.тип_результату = тип_результату;
      ф.назва = назва;
      ф.параметри.дані = дані_параметрів;
      ф.параметри.розмір = розмір_параметрів;
      ф.параметри.вмісткість = розмір_параметрів;
      ф.тіло = створити_тіло();
      ф.має_тіло = ні;

      біб::покласти_в_накопичувач<*Функція>(
        я.функції::адреса,
        ф
      );

      вернути ф;
    }

    внутрішня дія створити_базовий_блок(я: *Я, назва: *Назва) -> *БазовийБлок {
      змінна бб = біб::виділити<БазовийБлок>(1);
      бб.назва = назва;
      бб.елементи = біб::зробити_накопичувач<*ЕлементТіла>(0);

      біб::покласти_в_накопичувач<*БазовийБлок>(
        я.базові_блоки::адреса,
        бб
      );

      вернути бб;
    }
  }

  внутрішня дія створити_тіло() -> *Тіло {
    змінна тіло = біб::виділити<Тіло>(1);

    тіло.структури = біб::зробити_накопичувач<*Структура>(0);
    тіло.змінні = біб::зробити_накопичувач<*Змінна>(0);
    тіло.функції = біб::зробити_накопичувач<*Функція>(0);

    вернути тіло;
  }

  структура Файл {
    сн: СховищеНазв::Сховище;
    СІАНГ_ДЕФАЙН: ю8;
    СІАНГ_ТАЙПДЕФ: ю8;
    СІАНГ_СТРАКТ: ю8;
    СІАНГ_ВОЙД: ю8;
    СІАНГ_СТАТІК: ю8;
    тип_ніщо: *Тип;
    тип_адреса: *Тип;
    тип_логічне: *Тип;
    тип_ц8: *Тип;
    тип_ц16: *Тип;
    тип_ц32: *Тип;
    тип_ц64: *Тип;
    тип_ціле: *Тип;
    тип_п8: *Тип;
    тип_п16: *Тип;
    тип_п32: *Тип;
    тип_п64: *Тип;
    тип_природне: *Тип;
    тип_р32: *Тип;
    тип_р64: *Тип;
    тип_кд: *Тип;
    тип_ю8: *Тип;
    значення_пусто: *Вираз;
    тіло: *Тіло;

    внутрішня дія створити_логічне(я: *Я, значення: логічне) -> *Вираз {}

    внутрішня дія створити_п8(я: *Я, значення: п8) -> *Вираз {}

    внутрішня дія створити_п16(я: *Я, значення: п16) -> *Вираз {}

    внутрішня дія створити_п32(я: *Я, значення: п32) -> *Вираз {}

    внутрішня дія створити_п64(я: *Я, значення: п64) -> *Вираз {}

    внутрішня дія створити_ц8(я: *Я, значення: ц8) -> *Вираз {}

    внутрішня дія створити_ц16(я: *Я, значення: ц16) -> *Вираз {}

    внутрішня дія створити_ц32(я: *Я, значення: ц32) -> *Вираз {}

    внутрішня дія створити_ц64(я: *Я, значення: ц64) -> *Вираз {}

    внутрішня дія створити_р32(я: *Я, значення: р32) -> *Вираз {}

    внутрішня дія створити_р64(я: *Я, значення: р64) -> *Вираз {}
  }

  внутрішня дія створити_файл(сн: *СховищеНазв::Сховище) -> *Файл {
    змінна файл = біб::виділити<Файл>(1);

    файл.СІАНГ_ДЕФАЙН = ю8 { біб::виділити<п8>(7), 7 };
    файл.СІАНГ_ДЕФАЙН.дані[0] = 35;
    файл.СІАНГ_ДЕФАЙН.дані[1] = 100;
    файл.СІАНГ_ДЕФАЙН.дані[2] = 101;
    файл.СІАНГ_ДЕФАЙН.дані[3] = 102;
    файл.СІАНГ_ДЕФАЙН.дані[4] = 105;
    файл.СІАНГ_ДЕФАЙН.дані[5] = 110;
    файл.СІАНГ_ДЕФАЙН.дані[6] = 101;

    файл.СІАНГ_ТАЙПДЕФ = ю8 { біб::виділити<п8>(7), 7 };
    файл.СІАНГ_ТАЙПДЕФ.дані[0] = 116;
    файл.СІАНГ_ТАЙПДЕФ.дані[1] = 121;
    файл.СІАНГ_ТАЙПДЕФ.дані[2] = 112;
    файл.СІАНГ_ТАЙПДЕФ.дані[3] = 101;
    файл.СІАНГ_ТАЙПДЕФ.дані[4] = 100;
    файл.СІАНГ_ТАЙПДЕФ.дані[5] = 101;
    файл.СІАНГ_ТАЙПДЕФ.дані[6] = 102;

    файл.СІАНГ_СТРАКТ = ю8 { біб::виділити<п8>(6), 6 };
    файл.СІАНГ_СТРАКТ.дані[0] = 115;
    файл.СІАНГ_СТРАКТ.дані[1] = 116;
    файл.СІАНГ_СТРАКТ.дані[2] = 114;
    файл.СІАНГ_СТРАКТ.дані[3] = 117;
    файл.СІАНГ_СТРАКТ.дані[4] = 99;
    файл.СІАНГ_СТРАКТ.дані[5] = 116;

    файл.СІАНГ_ВОЙД = ю8 { біб::виділити<п8>(4), 4 };
    файл.СІАНГ_ВОЙД.дані[0] = 118;
    файл.СІАНГ_ВОЙД.дані[1] = 111;
    файл.СІАНГ_ВОЙД.дані[2] = 105;
    файл.СІАНГ_ВОЙД.дані[3] = 100;

    файл.СІАНГ_СТАТІК = ю8 { біб::виділити<п8>(6), 6 };
    файл.СІАНГ_СТАТІК.дані[0] = 115;
    файл.СІАНГ_СТАТІК.дані[1] = 116;
    файл.СІАНГ_СТАТІК.дані[2] = 97;
    файл.СІАНГ_СТАТІК.дані[3] = 116;
    файл.СІАНГ_СТАТІК.дані[4] = 105;
    файл.СІАНГ_СТАТІК.дані[5] = 99;

    файл.тип_ніщо = біб::виділити<Тип>(1);
    файл.тип_ніщо.вид = ВидТипуНазва;
    файл.тип_ніщо.дані = сн.отримати("ніщо");

    файл.тип_адреса = біб::виділити<Тип>(1);
    файл.тип_адреса.вид = ВидТипуНазва;
    файл.тип_адреса.дані = сн.отримати("адреса");

    файл.тип_логічне = біб::виділити<Тип>(1);
    файл.тип_логічне.вид = ВидТипуНазва;
    файл.тип_логічне.дані = сн.отримати("логічне");

    файл.тип_п8 = біб::виділити<Тип>(1);
    файл.тип_п8.вид = ВидТипуНазва;
    файл.тип_п8.дані = сн.отримати("п8");

    файл.тип_п16 = біб::виділити<Тип>(1);
    файл.тип_п16.вид = ВидТипуНазва;
    файл.тип_п16.дані = сн.отримати("п16");

    файл.тип_п32 = біб::виділити<Тип>(1);
    файл.тип_п32.вид = ВидТипуНазва;
    файл.тип_п32.дані = сн.отримати("п32");

    файл.тип_п64 = біб::виділити<Тип>(1);
    файл.тип_п64.вид = ВидТипуНазва;
    файл.тип_п64.дані = сн.отримати("п64");

    файл.тип_природне = біб::виділити<Тип>(1);
    файл.тип_природне.вид = ВидТипуНазва;
    файл.тип_природне.дані = сн.отримати("природне");

    файл.тип_ц8 = біб::виділити<Тип>(1);
    файл.тип_ц8.вид = ВидТипуНазва;
    файл.тип_ц8.дані = сн.отримати("ц8");

    файл.тип_ц16 = біб::виділити<Тип>(1);
    файл.тип_ц16.вид = ВидТипуНазва;
    файл.тип_ц16.дані = сн.отримати("ц16");

    файл.тип_ц32 = біб::виділити<Тип>(1);
    файл.тип_ц32.вид = ВидТипуНазва;
    файл.тип_ц32.дані = сн.отримати("ц32");

    файл.тип_ц64 = біб::виділити<Тип>(1);
    файл.тип_ц64.вид = ВидТипуНазва;
    файл.тип_ц64.дані = сн.отримати("ц64");

    файл.тип_ціле = біб::виділити<Тип>(1);
    файл.тип_ціле.вид = ВидТипуНазва;
    файл.тип_ціле.дані = сн.отримати("ціле");

    файл.тип_р32 = біб::виділити<Тип>(1);
    файл.тип_р32.вид = ВидТипуНазва;
    файл.тип_р32.дані = сн.отримати("р32");

    файл.тип_р64 = біб::виділити<Тип>(1);
    файл.тип_р64.вид = ВидТипуНазва;
    файл.тип_р64.дані = сн.отримати("р64");

    файл.тіло = створити_тіло();

    вернути файл;
  }

  дія перетворити_на_код(файл: *Файл, тіло: *Тіло, вихід: *ю8);
}