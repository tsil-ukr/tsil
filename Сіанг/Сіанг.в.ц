взяти біб Памʼять;
взяти визначення СховищеНазв;

простір Сіанг {
  структура Тіло;
  структура ЕлементТіла;
  структура ДаніЕлементаТілаПризначити;
  структура Параметри;
  структура Значення;
  структура ДаніЗначенняЗмінна;
  структура ДаніЗначенняФункція;
  структура ДаніЗначенняОперація;
  структура ДаніЗначенняСамоОперація;
  структура Тип;

  синонім Назва = СховищеНазв::Назва;

  структура Тіло {
    дані: *ЕлементТіла;
    розмір: природне;
    вмісткість: природне;
  }

  стала ВидЕлементаТілаПризначити = 1;
  стала ВидЕлементаТілаЗначення = 2;

  структура ДаніЕлементаТілаПризначити {
    назва: *Назва;
  }

  структура ЕлементТіла {
    вид: природне;
    дані: ДаніЕлементаТілаПризначити
        | *Значення;
  }

  внутрішня дія покласти_елемент_тіла(тіло: *Тіло, елемент_тіла: ЕлементТіла);

  структура Параметр {
    тип: *Тип;
    назва: *Назва;
  }

  структура Параметри {
    дані: *Параметр;
    розмір: природне;
    вмісткість: природне;
  }

  внутрішня дія покласти_параметр(параметри: *Параметри, параметр: Параметр);

  стала ВидЗначенняЗмінна = 1;
  стала ВидЗначенняФункція = 2;
  стала ВидЗначенняОперація = 3;
  стала ВидЗначенняСамоОперація = 4;

  структура ДаніЗначенняЗмінна {
    тип: *Тип;
    назва: *Назва
  }

  структура ДаніЗначенняФункція {
    тип_результату: *Тип;
    параметри: Параметри;
    тіло: Тіло;
  }

  стала ВидОпераціїДодати = 1;
  стала ВидОпераціїВідняти = 2;
  стала ВидОпераціїПомножити = 3;
  стала ВидОпераціїПоділити = 4;

  структура ДаніЗначенняОперація {
    вид: природне;
    ліво: *Значення;
    право: *Значення;
  }

  стала ВидСамоОпераціїВідʼємне = 1;

  структура ДаніЗначенняСамоОперація {
    вид: природне;
    значення: *Значення;
  }

  структура Значення {
    вид: природне;
    дані: ДаніЗначенняЗмінна
        | ДаніЗначенняФункція
        | ДаніЗначенняОперація
        | ДаніЗначенняСамоОперація;
  }

  внутрішня дія створити_значення_змінна(тип: *Тип, назва: *Назва) -> *Значення;
  внутрішня дія створити_значення_функція(тип_результату: *Тип, назва: *Назва, параметри: Параметри, тіло: Тіло) -> *Значення;
  внутрішня дія створити_значення_операція(вид: природне, ліво: *Значення, право: *Значення) -> *Значення;
  внутрішня дія створити_значення_само_операція(вид: природне, значення: *Значення) -> *Значення;

  стала ВидТипуВбудований = 1;
  стала ВидТипуСтруктура = 2;

  структура ДаніТипуСтруктура {
    назва: *Назва;
    параметри: Параметри;
  }

  структура Тип {
    вид: природне;
    дані: *Назва
        | ДаніТипуСтруктура;
  }

  внутрішня дія покласти_елемент_тіла(тіло: *Тіло, елемент_тіла: ЕлементТіла) {
    якщо тіло.розмір == тіло.вмісткість {
      тіло.вмісткість += 1;
      тіло.дані = біб::перевиділити<ЕлементТіла>(тіло.дані, тіло.вмісткість);
    }

    тіло.дані[тіло.розмір] = елемент_тіла;
    тіло.розмір += 1;
  }

  внутрішня дія покласти_параметр(параметри: *Параметри, параметр: Параметр) {
    якщо параметри.розмір == параметри.вмісткість {
      параметри.вмісткість += 1;
      параметри.дані = біб::перевиділити<Параметр>(параметри.дані, параметри.вмісткість);
    }

    параметри.дані[параметри.розмір] = параметр;
    параметри.розмір += 1;
  }

  внутрішня дія виділити_значення(вид: природне) -> *Значення {
    змінна з = біб::виділити<Значення>(1);
    з.вид = вид;
    вернути з;
  }

  внутрішня дія створити_значення_змінна(тип: *Тип, назва: *Назва) -> *Значення {
    змінна з = виділити_значення(ВидЗначенняЗмінна);
    з.дані = ДаніЗначенняЗмінна { тип, назва };
    вернути з;
  }

  внутрішня дія створити_значення_функція(тип_результату: *Тип, назва: *Назва, параметри: Параметри, тіло: Тіло) -> *Значення {
    змінна з = виділити_значення(ВидЗначенняФункція);
    з.дані = ДаніЗначенняФункція { тип_результату, параметри, тіло };
    вернути з;
  }

  внутрішня дія створити_значення_операція(вид: природне, ліво: *Значення, право: *Значення) -> *Значення {
    змінна з = виділити_значення(ВидЗначенняОперація);
    з.дані = ДаніЗначенняОперація { вид, ліво, право };
    вернути з;
  }

  внутрішня дія створити_значення_само_операція(вид: природне, значення: *Значення) -> *Значення {
    змінна з = виділити_значення(ВидЗначенняСамоОперація);
    з.дані = ДаніЗначенняСамоОперація { вид, значення };
    вернути з;
  }
}