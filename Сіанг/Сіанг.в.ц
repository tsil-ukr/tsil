взяти біб Памʼять;
взяти визначення СховищеНазв;

простір Сіанг {
  структура Файл;
  структура Тіло;
  структура ЕлементТіла;
  структура ДаніЕлементаТілаПризначити;
  структура Параметри;
  структура Значення;
  структура ДаніЗначенняЗмінна;
  структура ДаніЗначенняФункція;
  структура ДаніЗначенняОперація;
  структура ДаніЗначенняСамоОперація;
  структура Тип;

  синонім Назва = СховищеНазв::Назва;

  структура Файл {
    тип_ціле: *Тип;
    тіло: *Тіло;
  }

  структура Параметр {
    тип: *Тип;
    назва: *Назва;
  }

  стала ВидЗначенняЗмінна = 1;
  стала ВидЗначенняФункція = 2;
  стала ВидЗначенняОперація = 3;
  стала ВидЗначенняСамоОперація = 4;

  структура ДаніЗначенняЗмінна {
    тип: *Тип;
    назва: *Назва
  }

  структура ДаніЗначенняФункція {
    тип_результату: *Тип;
    назва: *Назва;
    параметри: біб::Накопичувач<Параметр>;
    тіло: *Тіло;
  }

  стала ВидОпераціїДодати = 1;
  стала ВидОпераціїВідняти = 2;
  стала ВидОпераціїПомножити = 3;
  стала ВидОпераціїПоділити = 4;

  структура ДаніЗначенняОперація {
    вид: природне;
    ліво: *Значення;
    право: *Значення;
  }

  стала ВидСамоОпераціїВідʼємне = 1;

  структура ДаніЗначенняСамоОперація {
    вид: природне;
    значення: *Значення;
  }

  структура Значення {
    вид: природне;
    дані: ДаніЗначенняЗмінна
        | ДаніЗначенняФункція
        | ДаніЗначенняОперація
        | ДаніЗначенняСамоОперація;
  }

  стала ВидТипуВбудований = 1;
  стала ВидТипуСтруктура = 2;

  структура ДаніТипуСтруктура {
    назва: *Назва;
    параметри: біб::Накопичувач<Параметр>;
  }

  структура Тип {
    вид: природне;
    дані: *Назва
        | ДаніТипуСтруктура;
  }

  стала ВидЕлементаТілаПризначити = 1;
  стала ВидЕлементаТілаЗначення = 2;

  структура ДаніЕлементаТілаПризначити {
    назва: *Назва;
  }

  структура ЕлементТіла {
    вид: природне;
    дані: ДаніЕлементаТілаПризначити
        | *Значення;
  }

  внутрішня дія виділити_значення(вид: природне) -> *Значення {
    змінна з = біб::виділити<Значення>(1);
    з.вид = вид;
    вернути з;
  }

  структура Тіло {
    типи: біб::Накопичувач<Тип>;
    змінні: біб::Накопичувач<Значення>;
    функції: біб::Накопичувач<Значення>;
    елементи: біб::Накопичувач<ЕлементТіла>;

    внутрішня дія створити_змінну(я: *Я, тип: *Тип, назва: *Назва) -> *Значення {
      змінна з: Значення;
      з.вид = ВидЗначенняЗмінна;
      з.дані = ДаніЗначенняЗмінна { тип, назва };

      біб::покласти_в_накопичувач<Значення>(я.змінні::адреса, з);

      вернути я.змінні.дані[я.змінні.розмір - 1]::адреса;
    }
  }

  внутрішня дія створити_тіло() -> *Тіло {
    змінна тіло = біб::виділити<Тіло>(1);

    тіло.типи = біб::зробити_накопичувач<Тип>(0);
    тіло.змінні = біб::зробити_накопичувач<Значення>(0);
    тіло.функції = біб::зробити_накопичувач<Значення>(0);
    тіло.елементи = біб::зробити_накопичувач<ЕлементТіла>(0);

    вернути тіло;
  }

  внутрішня дія створити_файл(сн: *СховищеНазв::Сховище) -> *Файл {
    змінна файл = біб::виділити<Файл>(1);

    файл.тип_ціле = біб::виділити<Тип>(1);
    файл.тип_ціле.вид = ВидТипуВбудований;
    файл.тип_ціле.дані = сн.отримати("ціле");
    файл.тіло = створити_тіло();

    вернути файл;
  }

  дія перетворити_на_код(тіло: *Тіло, вихід: *ю8);
}