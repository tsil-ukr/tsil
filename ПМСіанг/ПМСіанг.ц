  дія перетворити_на_сіанг(модуль: *ПМ::Модуль, вихід_розміру: *природне, вихід_даних: **п8) -> логічне {
    змінна файл = біб::виділити<Файл>(1);
    файл.лн = 0;
    файл.сн = модуль.сн;
    файл.типи = біб::зробити_накопичувач<ю8>(0);
    файл.структури = біб::зробити_накопичувач<Структура>(0);
    файл.функції = біб::зробити_накопичувач<*Функція>(0);

    біб::перебрати_реєстр<*ПМ::Назва, *ПМ::Значення>(
      модуль.глобальні,
      перебрати_реєстр_глобальних,
      файл
    );

    файл.отримати_сіанг(вихід_даних, вихід_розміру);

    вернути так;
  }
