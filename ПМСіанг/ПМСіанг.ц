дія перетворити_п64_в_ю8(
  значення: п64,
  вихід_даних: **п8,
  вихід_розміру: *природне
) -> ніщо;

дія перетворити_р64_в_ю8(
  значення: р64,
  вихід_даних: **п8,
  вихід_розміру: *природне
) -> ніщо;

простір ПМСіанг {
  внутрішня дія покласти_ю8(нк: *біб::Накопичувач<п8>, значення: ю8) {
    змінна п: природне = 0;

    поки п < значення.розмір {
      біб::покласти_в_накопичувач<п8>(нк, значення.дані[п]);

      п += 1;
    }
  }

  внутрішня дія покласти_кд(нк: *біб::Накопичувач<п8>, значення: кд) {
    змінна п: природне = 0;

    поки п < значення.розмір {
      біб::покласти_в_накопичувач<п8>(нк, значення.дані[п]);

      п += 1;
    }
  }

  внутрішня дія покласти_кд_п64(нк: *біб::Накопичувач<п8>, значення: п64) {
    змінна значення_ю8 = ю8 { пусто, 0 };
    змінна значення_кд = кд { пусто, 0 };
    змінна позиція_помилки = природне(0);

    перетворити_п64_в_ю8(значення, значення_ю8.дані::адреса, значення_ю8.розмір::адреса);

    біб::перекодувати_з_ю8(значення_ю8, так, так, значення_кд::адреса, пусто, позиція_помилки::адреса);
    біб::звільнити(значення_ю8.дані);

    покласти_кд(нк, значення_кд);
  }

  внутрішня дія покласти_ю8_п64(нк: *біб::Накопичувач<п8>, значення: п64) {
    змінна значення_ю8: ю8;

    перетворити_п64_в_ю8(значення, значення_ю8.дані::адреса, значення_ю8.розмір::адреса);

    покласти_ю8(нк, значення_ю8);
  }

  внутрішня дія покласти_ю8_р32(нк: *біб::Накопичувач<п8>, значення: р32) {
    змінна значення_ю8: ю8;

    перетворити_р64_в_ю8(р64(значення), значення_ю8.дані::адреса, значення_ю8.розмір::адреса);

    покласти_ю8(нк, значення_ю8);
  }

  внутрішня дія покласти_ю8_р64(нк: *біб::Накопичувач<п8>, значення: р64) {
    змінна значення_ю8: ю8;

    перетворити_р64_в_ю8(значення, значення_ю8.дані::адреса, значення_ю8.розмір::адреса);

    покласти_ю8(нк, значення_ю8);
  }

  структура Структура {
    назва: *СховищеНазв::Назва;
    код: ю8;
  }

  структура Крок {
    назва: *СховищеНазв::Назва;
    код: ю8;
  }

  структура Функція {
    назва: *СховищеНазв::Назва;
    оголошення: ю8;
    кроки: біб::Накопичувач<*Крок>;

    внутрішня дія створити_крок(я: *Я, назва: *СховищеНазв::Назва) -> *Крок {
      змінна крок = біб::виділити<Крок>(1);
      крок.назва = назва;
      крок.код = ю8 { пусто, 0 };

      біб::покласти_в_накопичувач<*Крок>(
        я.кроки::адреса,
        крок
      );

      вернути крок;
    }
  }

  структура Файл {
    лн: природне;
    сн: *СховищеНазв::Сховище;
    типи: біб::Накопичувач<ю8>;
    структури: біб::Накопичувач<Структура>;
    функції: біб::Накопичувач<*Функція>;

    внутрішня дія онн(я: *Я) ->  *СховищеНазв::Назва {
      змінна нн = біб::зробити_накопичувач<п8>(0);
      покласти_кд(нн::адреса, "назва_");
      покласти_кд_п64(нн::адреса, п64(я.лн));

      змінна назва = я.сн.отримати(кд { нн.дані, нн.розмір });

      біб::звільнити(нн.дані);

      я.лн += 1;

      вернути назва;
    }

    внутрішня дія отримати_сіанг(я: *Я, вихід_даних: **п8, вихід_розміру: *природне) {
      змінна нк = біб::зробити_накопичувач<п8>(0);
      змінна п: природне;

      п = 0;
      поки п < я.структури.розмір {
        покласти_ю8(нк::адреса, ю8"тайпдеф структ ");
        покласти_ю8(нк::адреса, я.структури.дані[п].назва.як_ю8());
        покласти_ю8(нк::адреса, ю8" ");
        покласти_ю8(нк::адреса, я.структури.дані[п].назва.як_ю8());
        покласти_ю8(нк::адреса, ю8";\р");

        п += 1;
      }

      п = 0;
      поки п < я.типи.розмір {
        покласти_ю8(нк::адреса, я.типи.дані[п]);
        покласти_ю8(нк::адреса, ю8"\р");

        п += 1;
      }

      п = 0;
      поки п < я.структури.розмір {
        покласти_ю8(нк::адреса, я.структури.дані[п].код);
        покласти_ю8(нк::адреса, ю8"\р");

        п += 1;
      }

      п = 0;
      поки п < я.функції.розмір {
        покласти_ю8(нк::адреса, я.функції.дані[п].оголошення);
        покласти_ю8(нк::адреса, ю8";\р");

        п += 1;
      }

      п = 0;
      поки п < я.функції.розмір {
        змінна ф = я.функції.дані[п];
        змінна пп: природне = 0;

        покласти_ю8(нк::адреса, ф.оголошення);
        покласти_ю8(нк::адреса, ю8" {\р");

        поки пп < ф.кроки.розмір {
          змінна крок = ф.кроки.дані[пп];

          покласти_ю8(нк::адреса, крок.код);

          пп += 1;
        }

        покласти_ю8(нк::адреса, ю8"}\р");

        п += 1;
      }

      вихід_даних::вміст = нк.дані;
      вихід_розміру::вміст = нк.розмір;
    }
  }

  внутрішня дія скомпілювати_тип(файл: *Файл, тип: *ПМ::Тип) -> *СховищеНазв::Назва;
  внутрішня дія скомпілювати_значення(файл: *Файл, функція: *Функція, значення: *ПМ::Значення, нк: *біб::Накопичувач<п8>) -> *СховищеНазв::Назва;

  внутрішня дія назва_з_п64(файл: *Файл, значення: п64) -> *СховищеНазв::Назва {
    змінна значення_ю8 = ю8 { пусто, 0 };
    змінна значення_кд = кд { пусто, 0 };
    змінна позиція_помилки = природне(0);

    перетворити_п64_в_ю8(значення, значення_ю8.дані::адреса, значення_ю8.розмір::адреса);

    біб::перекодувати_з_ю8(значення_ю8, так, так, значення_кд::адреса, пусто, позиція_помилки::адреса);
    біб::звільнити(значення_ю8.дані);

    змінна назва = файл.сн.отримати(значення_кд);

    біб::звільнити(значення_кд.дані);

    вернути назва;
  }

  внутрішня дія назва_з_р64(файл: *Файл, значення: р64) -> *СховищеНазв::Назва {
    змінна значення_ю8 = ю8 { пусто, 0 };
    змінна значення_кд = кд { пусто, 0 };
    змінна позиція_помилки = природне(0);

    перетворити_р64_в_ю8(значення, значення_ю8.дані::адреса, значення_ю8.розмір::адреса);

    біб::перекодувати_з_ю8(значення_ю8, так, так, значення_кд::адреса, пусто, позиція_помилки::адреса);
    біб::звільнити(значення_ю8.дані);

    змінна назва = файл.сн.отримати(значення_кд);

    біб::звільнити(значення_кд.дані);

    вернути назва;
  }

  внутрішня дія скомпілювати_тип(файл: *Файл, тип: *ПМ::Тип) -> *СховищеНазв::Назва {
    змінна модуль = тип.модуль;

    якщо тип.дані_компіляції == пусто {
      якщо тип == модуль.тип_ніщо {
        тип.дані_компіляції = модуль.сн.отримати("ніщо");
      } інакше якщо тип == модуль.тип_адреса {
        тип.дані_компіляції = модуль.сн.отримати("адреса");
      } інакше якщо тип == модуль.тип_логічне {
        тип.дані_компіляції = модуль.сн.отримати("логічне");
      } інакше якщо тип == модуль.тип_ц8 {
        тип.дані_компіляції = модуль.сн.отримати("п8");
      } інакше якщо тип == модуль.тип_ц16 {
        тип.дані_компіляції = модуль.сн.отримати("п16");
      } інакше якщо тип == модуль.тип_ц32 {
        тип.дані_компіляції = модуль.сн.отримати("п32");
      } інакше якщо тип == модуль.тип_ц64 {
        тип.дані_компіляції = модуль.сн.отримати("п64");
      } інакше якщо тип == модуль.тип_р32 {
        тип.дані_компіляції = модуль.сн.отримати("р32");
      } інакше якщо тип == модуль.тип_р64 {
        тип.дані_компіляції = модуль.сн.отримати("р64");
      } інакше якщо тип.вид == ПМ::ВидТипуІнструкція {
        змінна дані_типу_інструкція = тип.дані як ПМ::ДаніТипуІнструкція;

        змінна назва = файл.онн();

        змінна нктф = біб::зробити_накопичувач<п8>(0);

        змінна тип_результату = скомпілювати_тип(файл, дані_типу_інструкція.тип_результату);

        покласти_ю8(нктф::адреса, ю8"тайпдеф");
        покласти_ю8(нктф::адреса, ю8" ");
        покласти_ю8(нктф::адреса, тип_результату.як_ю8());
        покласти_ю8(нктф::адреса, ю8" (*");
        покласти_ю8(нктф::адреса, назва.як_ю8());
        покласти_ю8(нктф::адреса, ю8")(");

        змінна п: природне = 0;
        поки п < дані_типу_інструкція.параметри.розмір {
          змінна параметр = дані_типу_інструкція.параметри.дані[п];

          змінна тип = скомпілювати_тип(файл, параметр.тип);

          покласти_ю8(нктф::адреса, тип.як_ю8());

          якщо п != (дані_типу_інструкція.параметри.розмір - 1) {
            покласти_ю8(нктф::адреса, ю8", ");
          }

          п += 1;
        }

        покласти_ю8(нктф::адреса, ю8");");

        біб::покласти_в_накопичувач<ю8>(
          файл.типи::адреса,
          ю8 { нктф.дані, нктф.розмір }
        );

        тип.дані_компіляції = назва;
      } інакше якщо тип.вид == ПМ::ВидТипуСтруктура {
        змінна дані_типу_структура = тип.дані як ПМ::ДаніТипуСтруктура;

        змінна нкс = біб::зробити_накопичувач<п8>(0);
        покласти_ю8(нкс::адреса, ю8"структ ");
        покласти_ю8(нкс::адреса, дані_типу_структура.назва.як_ю8());
        покласти_ю8(нкс::адреса, ю8" {\р");

        змінна п: природне = 0;
        поки п < дані_типу_структура.параметри.розмір {
          змінна параметр = дані_типу_структура.параметри.дані[п];

          змінна тип = скомпілювати_тип(файл, параметр.тип);
          змінна назва = файл.онн();

          покласти_ю8(нкс::адреса, ю8"  ");
          покласти_ю8(нкс::адреса, тип.як_ю8());
          покласти_ю8(нкс::адреса, ю8" ");
          покласти_ю8(нкс::адреса, назва.як_ю8());
          покласти_ю8(нкс::адреса, ю8";\р");

          п += 1;
        }

        покласти_ю8(нкс::адреса, ю8"};");

        змінна с: Структура;
        с.назва = дані_типу_структура.назва;
        с.код = ю8 { нкс.дані, нкс.розмір };

        біб::покласти_в_накопичувач<Структура>(файл.структури::адреса, с);

        тип.дані_компіляції = дані_типу_структура.назва;
      } інакше якщо тип.вид == ПМ::ВидТипуМасив {
        // змінна дані_типу_масив = тип.дані як ПМ::ДаніТипуМасив;
        // змінна ллвм_тип_елемента = ЛЛВМ::тип_войд();
        // якщо дані_типу_масив.тип_елемента != пусто {
        //   якщо не скомпілювати_тип(ллвм_модуль, дані_типу_масив.тип_елемента) {
        //     вернути ні;
        //   }
        //   ллвм_тип_елемента = дані_типу_масив.тип_елемента.дані_компіляції як *ЛЛВМ::Тип;
        // }
        // тип.дані_компіляції = ЛЛВМ::тип_аррай(
        //   ллвм_тип_елемента,
        //   дані_типу_масив.розмір
        // );
      }
    }

    вернути тип.дані_компіляції як *СховищеНазв::Назва;
  }

  внутрішня дія скомпілювати_крок(модуль: *ПМ::Модуль, файл: *Файл, функція: *Функція, крок: *ПМ::Крок) -> *Крок {
    якщо крок.дані_компіляції == пусто {
      змінна к = функція.створити_крок(крок.назва);

      крок.дані_компіляції = к;

      змінна нк = біб::зробити_накопичувач<п8>(0);

      покласти_ю8(нк::адреса, крок.назва.як_ю8());
      покласти_ю8(нк::адреса, ю8":\р");

      змінна пп: природне = 0;
      поки пп < крок.вказівки.розмір {
        змінна вказівка = крок.вказівки.дані[пп];

        скомпілювати_значення(файл, функція, вказівка, нк::адреса);

        пп += 1;
      }

      к.код = ю8 { нк.дані, нк.розмір };
    }

    вернути крок.дані_компіляції як *Крок;
  }

  внутрішня дія отт_п(тип: *ПМ::Тип) -> ю8 {
    якщо тип == тип.модуль.тип_ц8 {
      вернути ю8"п8";
    }

    якщо тип == тип.модуль.тип_ц16 {
      вернути ю8"п16";
    }

    якщо тип == тип.модуль.тип_ц32 {
      вернути ю8"п32";
    }

    якщо тип == тип.модуль.тип_ц64 {
      вернути ю8"п64";
    }
  }

  внутрішня дія отт_ц(тип: *ПМ::Тип) -> ю8 {
    якщо тип == тип.модуль.тип_ц8 {
      вернути ю8"ц8";
    }

    якщо тип == тип.модуль.тип_ц16 {
      вернути ю8"ц16";
    }

    якщо тип == тип.модуль.тип_ц32 {
      вернути ю8"ц32";
    }

    якщо тип == тип.модуль.тип_ц64 {
      вернути ю8"ц64";
    }
  }

  внутрішня дія отт_р(тип: *ПМ::Тип) -> ю8 {
    якщо тип == тип.модуль.тип_р32 {
      вернути ю8"р32";
    }

    якщо тип == тип.модуль.тип_р64 {
      вернути ю8"р64";
    }
  }

  внутрішня дія скомпілювати_значення(файл: *Файл, функція: *Функція, значення: *ПМ::Значення, нк: *біб::Накопичувач<п8>) -> *СховищеНазв::Назва {
    якщо значення.дані_компіляції == пусто {
      змінна модуль = значення.модуль;
      змінна тип_значення = скомпілювати_тип(файл, значення.тип);
      змінна назва: *СховищеНазв::Назва;

      якщо значення.вид == ПМ::ВидЗначенняЛогічне {
        змінна значення_логічного = значення.дані як логічне;

        якщо значення_логічного {
          значення.дані_компіляції = файл.сн.отримати("так");
        } інакше {
          значення.дані_компіляції = файл.сн.отримати("ні");
        }
      } інакше якщо значення.вид == ПМ::ВидЗначенняБеззнаковеЦіле {
        якщо значення.тип == модуль.тип_ц8 {
          змінна значення_п8 = значення.дані як п8;

          назва = назва_з_п64(файл, п64(значення_п8));

          значення.дані_компіляції = назва;
        } інакше якщо значення.тип == модуль.тип_ц16 {
          змінна значення_п16 = значення.дані як п16;

          назва = назва_з_п64(файл, п64(значення_п16));

