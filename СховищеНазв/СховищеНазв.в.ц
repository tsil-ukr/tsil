взяти біб Памʼять;

простір СховищеНазв {
  структура Назва {
    значення: кд;
  }

  структура Сховище {
    розмір: природне;
    дані: **Назва;
    вмісткість: природне;

    внутрішня дія отримати(я: *Я, значення: кд) -> *Назва {
      змінна знайдена_назва: *Назва = пусто;
      змінна п: природне = 0;

      поки п < я.розмір {
        якщо КД::перевірити_чи_кд_рівні(я.дані[п].значення, значення) {
          вернути я.дані[п];
        }
        п += 1;
      }

      змінна нова_назва = біб::виділити<Назва>(1);

      нова_назва.значення = кд {
        біб::виділити<п8>(значення.розмір),
        значення.розмір,
      };

      п = 0;
      поки п < значення.розмір {
        нова_назва.значення.дані[п] = значення.дані[п];
        п += 1;
      }

      якщо я.розмір == я.вмісткість {
        я.вмісткість += 1;
        я.дані = біб::перевиділити<*Назва>(я.дані, я.вмісткість);
      }

      я.дані[я.розмір] = нова_назва;
      я.розмір += 1;

      вернути нова_назва;
    }
  }


  внутрішня дія створити_сховище() -> *Сховище {
    змінна сховище = біб::виділити<Сховище>(1);

    сховище.розмір = 0;
    сховище.дані = пусто;
    сховище.вмісткість = 0;

    вернути сховище;
  }

  внутрішня дія знищити_сховище(сховище: *Сховище) {
    змінна п: природне = 0;

    поки п < сховище.розмір {
      біб::звільнити(сховище.дані[п].значення.дані);
      біб::звільнити(сховище.дані[п]);

      п += 1;
    }

    біб::звільнити(сховище.дані);
    біб::звільнити(сховище);
  }
}

