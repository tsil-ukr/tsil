взяти біб Памʼять;
взяти біб Реєстр;
взяти біб Друк;
взяти біб Кодування;
взяти біб Накопичувач;
взяти біб Шлях;
взяти біб Інформація;
взяти біб Файли;
взяти визначення ПМ;
взяти визначення ./розбирач;

простір КЦ {
  структура Компілятор;
  структура Середовище;
  структура Обʼєкт;
  структура ОбʼєктТипу;
  структура ОбʼєктДії;
  структура ОбʼєктСекції;
  структура ОбʼєктШаблону;
  структура ОбʼєктНезавантаженогоЗначення;
  структура ОбʼєктЗначення;
  структура ОбʼєктСирогоЗначення;
  стала ВидимістьВнутрішня = 1;
  стала ВидимістьЗовнішня = 3;

  внутрішня дія змішати_шлях_для_реєстру<З>(реєстр: *біб::Реєстр<біб::Шлях, З>, ключ: біб::Шлях) -> природне {
    змінна змішане: природне = 5381;
    змінна п: природне = 0;

    поки п < ключ.розмір {
      змішане = (змішане * 33) + природне(ключ.дані[п]);
      п += 1;
    }

    вернути змішане;
  }

  внутрішня дія перевірити_шляхи_в_реєстрі<З>(реєстр: *біб::Реєстр<біб::Шлях, З>, а: біб::Шлях, б: біб::Шлях) -> логічне {
    якщо а.розмір != б.розмір {
      вернути ні;
    }

    змінна п: природне = 0;

    поки п < а.розмір {
      якщо а.дані[п] != б.дані[п] {
        вернути ні;
      }

      п += 1;
    }

    вернути так;
  }

  структура Байти {
    розмір: природне;
    дані: *п8;
  }

  синонім Назва = ПМ::Назва;

  дія отримати_назву(компілятор: *Компілятор, значення: кд) -> *Назва;

  внутрішня дія змішати_назву_шлях_для_реєстру<З>(реєстр: *біб::Реєстр<*Назва, З>, ключ: *Назва) -> природне {
    змінна змішане: природне = 5381;
    змінна п: природне = 0;

    поки п < ключ.значення.розмір {
      змішане = (змішане * 33) + природне(ключ.значення.дані[п]);
      п += 1;
    }

    вернути змішане;
  }

  дія знищити_назву_якщо_копія(компілятор: *Компілятор, назва: *Назва);

  структура ТекстКоду;
  структура ОригінальнеЗначенняТекстуКоду;

  структура ТекстКоду {
    наступний: *ТекстКоду;
    компілятор: *Компілятор;
    шлях: біб::Шлях; // копія
    значення: кд;
    оригінальне_значення: *ОригінальнеЗначенняТекстуКоду;
  }

  структура ОригінальнеЗначенняТекстуКоду {
    значення: ю8;
    місцезнаходження: біб::МісцезнаходженняПерекодованого;
  }

  дія створити_текст_коду(компілятор: *Компілятор) -> *ТекстКоду;
  дія знищити_текст_коду(текст_коду: *ТекстКоду);

  структура РозібранийТекст;

  структура РозібранийТекст {
    наступний: *РозібранийТекст;
    компілятор: *Компілятор;
    текст_коду: *ТекстКоду;
    розбирач: *КЦ::розбирач::Розбирач;
    слова: КЦ::розбирач::Слова;
    сполуки: КЦ::розбирач::Сполуки;
  }

  дія створити_розібраний_текст(компілятор: *Компілятор) -> *РозібранийТекст;
  дія знищити_розібраний_текст(розібраний_текст: *РозібранийТекст);

  структура Місцезнаходження {
    розібраний_текст: *РозібранийТекст;
    позиція_слова: природне;
  }

  структура ОбʼєктНезавантаженогоЗначення {
    тип: *ОбʼєктТипу;
    пм_значення: *ПМ::Значення;
  }

  структура ОбʼєктЗначення {
    тип: *ОбʼєктТипу;
    пм_значення: *ПМ::Значення;
  }

  стала ВидСирогоОбʼєктаЧисло = 1;
  стала ВидСирогоОбʼєктаПусто = 2;

  структура ОбʼєктСирогоЗначення {
    наступний: *ОбʼєктСирогоЗначення;
    компілятор: *Компілятор;
    вид: природне;
    дані: кд; // звільнити коли обʼєкт не потрібен
  }

  дія виділити_обʼєкт_сирого_значення(компілятор: *Компілятор) -> *ОбʼєктСирогоЗначення;
  дія знищити_обʼєкт_сирого_значення(компілятор: *Компілятор, обʼєкт_сирого_значення: *ОбʼєктСирогоЗначення);

  стала ВидОбʼєктаТип = 1;
  стала ВидОбʼєктаДія = 2;
  стала ВидОбʼєктаСекція = 3;
  стала ВидОбʼєктаШаблон = 4;
  стала ВидОбʼєктаНезавантаженеЗначення = 5;
  стала ВидОбʼєктаЗначення = 6;
  стала ВидОбʼєктаСиреЗначення = 7;

  структура Обʼєкт {
    вид: природне;
    дані: *ОбʼєктТипу
        | *ОбʼєктДії
        | *ОбʼєктСекції
        | *ОбʼєктШаблону
        | ОбʼєктНезавантаженогоЗначення
        | ОбʼєктЗначення
        | *ОбʼєктСирогоЗначення;
  }

  структура Параметр {
    назва: *Назва;
    тип: *ОбʼєктТипу;
    місцезнаходження_назви: Місцезнаходження; // якщо назва.розмір == 0, тоді це місцезнаходження не актуальне
    місцезнаходження_типу: Місцезнаходження; // якщо тип == пусто, тоді це місцезнаходження не актуальне
  }

  дія знищити_параметр(компілятор: *Компілятор, параметр: Параметр);

  структура Параметри {
    розмір: природне;
    дані: *Параметр;
    вмісткість: природне;
  }

  дія знищити_параметри(компілятор: *Компілятор, параметри: Параметри);

  структура ДаніОбʼєктаТипуПростий {
    назва: *Назва;
  }

  стала ВидАргументаГотовихШаблонуОбʼєктТипу = 1;
  стала ВидАргументаГотовихШаблонуОбʼєктСирогоЗначення = 2;

  структура ГотовийАргументШаблону {
    вид: природне;
    значення: *ОбʼєктТипу | *ОбʼєктСирогоЗначення;
  }

  структура ГотовіАргументиШаблону {
    розмір: природне;
    дані: *ГотовийАргументШаблону;
  }

  дія знищити_готові_аргументи_шаблону(компілятор: *Компілятор, готові_аргументи_шаблону: ГотовіАргументиШаблону);

  структура ДаніОбʼєктаТипуСтруктура {
    назва: *Назва;
    параметри: Параметри;
    повна_назва: *Назва;
    готові_аргументи_шаблону: ГотовіАргументиШаблону;
    пакована: логічне;
    дії: *Середовище;
  }

  структура ДаніОбʼєктаТипуДія {
    параметри: Параметри;
    тип_результату: *ОбʼєктТипу;
    пм_тип_інструкції: *ПМ::Тип;
  }

  структура ДаніОбʼєктаТипуАдреса {
    тип_даних: *ОбʼєктТипу;
  }

  структура ДаніОбʼєктаТипуМасив {
    тип_даних: *ОбʼєктТипу;
    розмір_масиву: природне;
  }

  структура ДаніОбʼєктаТипуВаріація {
    кількість_типів: природне;
    типи: **ОбʼєктТипу;
    найбільший_тип: *ОбʼєктТипу;
  }

  стала ВидОбʼєктаТипуПростий = 1;
  стала ВидОбʼєктаТипуСтруктура = 2;
  стала ВидОбʼєктаТипуДія = 3;
  стала ВидОбʼєктаТипуАдреса = 4;
  стала ВидОбʼєктаТипуМасив = 6;
  стала ВидОбʼєктаТипуВаріація = 7;

  структура ОбʼєктТипу {
    наступний: *ОбʼєктТипу;
    вид: природне;
    пм_тип: *ПМ::Тип;
    дані: ДаніОбʼєктаТипуПростий
        | ДаніОбʼєктаТипуСтруктура
        | ДаніОбʼєктаТипуДія
        | ДаніОбʼєктаТипуАдреса
        | ДаніОбʼєктаТипуМасив
        | ДаніОбʼєктаТипуВаріація;
  }

  дія виділити_обʼєкт_типу(компілятор: *Компілятор) -> *ОбʼєктТипу;
  дія знищити_обʼєкт_типу(компілятор: *Компілятор, обʼєкт_типу: *ОбʼєктТипу);

  структура Крок {
    назва: *Назва;
    обʼєкт_дії: *ОбʼєктДії;
    пм_крок: *ПМ::Крок;
  }

  дія знищити_крок(компілятор: *Компілятор, крок: Крок);

  структура Кроки {
    розмір: природне;
    дані: *Крок;
    вмісткість: природне;
  }

  дія знищити_кроки(компілятор: *Компілятор, кроки: Кроки);

  структура Стрибок {
    назва: *Назва;
    обʼєкт_дії: *ОбʼєктДії;
    пм_стрибок: *ПМ::Стрибок;
    місцезнаходження: розбирач::Місцезнаходження;
  }

  дія знищити_стрибок(компілятор: *Компілятор, стрибок: Стрибок);

  структура Стрибки {
    розмір: природне;
    дані: *Стрибок;
    вмісткість: природне;
  }

  дія знищити_стрибки(компілятор: *Компілятор, стрибки: Стрибки);

  структура ОбʼєктДії {
    наступний: *ОбʼєктДії;
    видимість: природне;
    назва: *Назва;
    місцезнаходження: Місцезнаходження;
    місцезнаходження_назви: Місцезнаходження;
    повна_назва: *Назва;
    параметри: Параметри;
    тип_результату: *ОбʼєктТипу;
    місцезнаходження_типу_результату: Місцезнаходження;
    тип: *ОбʼєктТипу;
    пм_інструкція: *ПМ::Інструкція;
    має_тіло: природне;
    кроки: Кроки;
    стрибки: Стрибки;
  }

  дія виділити_обʼєкт_дії(компілятор: *Компілятор) -> *ОбʼєктДії;
  дія знищити_обʼєкт_дії(компілятор: *Компілятор, обʼєкт_дії: *ОбʼєктДії);

  структура ОбʼєктСекції {
    наступний: *ОбʼєктСекції;
    назва: *Назва;
    середовище: *Середовище;
  }

  дія виділити_обʼєкт_секції(компілятор: *Компілятор) -> *ОбʼєктСекції;
  дія знищити_обʼєкт_секції(компілятор: *Компілятор, обʼєкт_секції: *ОбʼєктСекції);

  структура КонтекстКомпіляціїДії {
    обʼєкт_дії: *ОбʼєктДії;
    крок_накопичень: Крок;
    значення_вернути: ОбʼєктНезавантаженогоЗначення;
    крок_вернути: Крок;
    поточний_крок: Крок;
  }

  структура КонтекстКомпіляціїВиконанняШаблону {
    обʼєкт_шаблону: *ОбʼєктШаблону;
    готові_аргументи_шаблону: ГотовіАргументиШаблону;
  }

  структура Контекст {
    розібраний_текст: *РозібранийТекст;
    середовище: *Середовище;
    кк_дії: *КонтекстКомпіляціїДії;
  }

  структура ОбʼєктШаблону {
    наступний: *ОбʼєктШаблону;
    назва: *Назва;
    параметри: Параметри;
    сполука: *розбирач::Сполука;
    готові: *біб::Реєстр<ГотовіАргументиШаблону, Обʼєкт>;
    контекст_компіляції: Контекст;
  }

  дія знищити_обʼєкт_шаблону(компілятор: *Компілятор, обʼєкт_шаблону: *ОбʼєктШаблону);

  структура Середовище {
    наступне: *Середовище;
    компілятор: *Компілятор;
    зовнішнє: *Середовище;
    субʼєкти: *біб::Реєстр<*Назва, Обʼєкт>;
    обʼєкт_секції: *ОбʼєктСекції;
    обʼєкт_дії: *ОбʼєктДії;
  }

  дія створити_середовище(компілятор: *Компілятор, зовнішнє: *Середовище) -> *Середовище;
  дія створити_середовище_секції(компілятор: *Компілятор, зовнішнє: *Середовище, обʼєкт_секції: *ОбʼєктСекції) -> *Середовище;
  дія створити_середовище_дії(компілятор: *Компілятор, зовнішнє: *Середовище, обʼєкт_дії: *ОбʼєктДії) -> *Середовище;
  дія знищити_середовище(середовище: *Середовище);
  дія змінити_в_середовищі(середовище: *Середовище, назва: *Назва, обʼєкт: Обʼєкт);
  дія знайти_в_середовищі(середовище: *Середовище, назва: *Назва, вихід: *Обʼєкт) -> логічне;
  дія знайти_в_середовищі_рекурсивно(середовище: *Середовище, назва: *Назва, вихід: *Обʼєкт) -> логічне;

  структура ВзятіФайли {
    компілятор: *Компілятор;
    реєстр: *біб::Реєстр<біб::Шлях, *РозібранийТекст>;
  }

  дія створити_взяті_файли(компілятор: *Компілятор) -> *ВзятіФайли;
  дія знищити_взяті_файли(взяті_файли: *ВзятіФайли);

  // шлях буде клоновано
  дія покласти_взятий_файл(взяті_файли: *ВзятіФайли, шлях: біб::Шлях, розібраний_текст: *РозібранийТекст);

  дія знайти_взятий_файл(взяті_файли: *ВзятіФайли, шлях: біб::Шлях, вихід: **РозібранийТекст) -> логічне;

  структура Компілятор {
    пм_модуль: *ПМ::Модуль;
    кореневий_шлях: біб::Шлях; // копія
    шлях_до_біб: біб::Шлях; // копія
    шляхи_до_визначень: біб::Накопичувач<біб::Шлях>;
    взяті_файли: *ВзятіФайли;
    пм_сховище_назв: *ПМ::СховищеНазв;
    перше_середовище: *Середовище;
    останнє_середовище: *Середовище;
    перший_обʼєкт_дії: *ОбʼєктДії;
    останній_обʼєкт_дії: *ОбʼєктДії;
    перший_обʼєкт_типу: *ОбʼєктТипу;
    останній_обʼєкт_типу: *ОбʼєктТипу;
    перший_обʼєкт_шаблону: *ОбʼєктШаблону;
    останній_обʼєкт_шаблону: *ОбʼєктШаблону;
    перший_обʼєкт_секції: *ОбʼєктСекції;
    останній_обʼєкт_секції: *ОбʼєктСекції;
    перший_обʼєкт_сирого_значення: *ОбʼєктСирогоЗначення;
    останній_обʼєкт_сирого_значення: *ОбʼєктСирогоЗначення;
    перший_розібраний_текст: *РозібранийТекст;
    останній_розібраний_текст: *РозібранийТекст;
    перший_текст_коду: *ТекстКоду;
    останній_текст_коду: *ТекстКоду;
    глобальне_середовище: *Середовище;
    тип_ніщо: *ОбʼєктТипу;
    тип_адреса: *ОбʼєктТипу;
    тип_памʼять: *ОбʼєктТипу;
    тип_логічне: *ОбʼєктТипу;
    тип_ц8: *ОбʼєктТипу;
    тип_ц16: *ОбʼєктТипу;
    тип_ц32: *ОбʼєктТипу;
    тип_ц64: *ОбʼєктТипу;
    тип_ціле: *ОбʼєктТипу;
    тип_п8: *ОбʼєктТипу;
    тип_п16: *ОбʼєктТипу;
    тип_п32: *ОбʼєктТипу;
    тип_п64: *ОбʼєктТипу;
    тип_природне: *ОбʼєктТипу;
    тип_р32: *ОбʼєктТипу;
    тип_р64: *ОбʼєктТипу;
    тип_кд: *ОбʼєктТипу;
    тип_т16: *ОбʼєктТипу;
    тип_ю8: *ОбʼєктТипу;
    тип_ю32: *ОбʼєктТипу;
    обʼєкт_значення_так: ОбʼєктЗначення;
    обʼєкт_значення_ні: ОбʼєктЗначення;
