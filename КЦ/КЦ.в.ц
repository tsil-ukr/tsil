простір КЦ {
  структура НакопичувачКД {
    значення: кд;
  }

  внутрішня дія зробити_накопичувач_кд(компілятор: *Компілятор) -> НакопичувачКД {
    вернути НакопичувачКД {
      значення = кд { пусто, 0 }
    };
  }

  внутрішня дія покласти_в_накопичувач_кд(компілятор: *Компілятор, накопичувач_кд: *НакопичувачКД, значення: кд) {
    накопичувач_кд.значення.дані = біб::перевиділити<п8>(накопичувач_кд.значення.дані, накопичувач_кд.значення.розмір + значення.розмір);

    змінна п: природне = 0;

    поки п < значення.розмір {
      накопичувач_кд.значення.дані[накопичувач_кд.значення.розмір + п] = значення.дані[п];

      п += 1;
    }

    накопичувач_кд.значення.розмір += значення.розмір;
  }

  внутрішня дія покласти_спереду_накопичувача_кд(компілятор: *Компілятор, накопичувач_кд: *НакопичувачКД, значення: кд) {
    змінна старі_дані = накопичувач_кд.значення.дані;

    накопичувач_кд.значення.дані = біб::виділити<п8>(накопичувач_кд.значення.розмір + значення.розмір);

    змінна п: природне = 0;
    поки п < накопичувач_кд.значення.розмір {
      накопичувач_кд.значення.дані[п + значення.розмір] = старі_дані[п];
      п += 1;
    }

    біб::звільнити(старі_дані);

    п = 0;
    поки п < значення.розмір {
      накопичувач_кд.значення.дані[п] = значення.дані[п];
      п += 1;
    }

    накопичувач_кд.значення.розмір += значення.розмір;
  }

  внутрішня дія покласти_природне_в_накопичувач_кд(компілятор: *Компілятор, накопичувач_кд: *НакопичувачКД, значення: природне) {
    змінна значення_ю8 = біб::перетворити_природне_на_ю8(значення);
    змінна значення_кд = кд { пусто, 0 };
    змінна позиція_помилки: природне = 0;
    якщо біб::перекодувати_з_ю8(значення_ю8, так, так, значення_кд::адреса, пусто, позиція_помилки::адреса) == ні {
      КЦ::померти(компілятор, "Не вдалось перекодувати ю8 в кд.");
    }
    покласти_в_накопичувач_кд(компілятор, накопичувач_кд, значення_кд);
    біб::звільнити(значення_ю8.дані);
    біб::звільнити(значення_кд.дані);
  }
}

простір КЦ {
