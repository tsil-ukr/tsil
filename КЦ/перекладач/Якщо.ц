взяти визначення КЦ;

простір КЦ {
  дія скомпілювати_якщо(
    компілятор: *Компілятор,
    контекст: Контекст,
    дані_якщо: розбирач::ДаніСполукиЯкщо,
    місцезнаходження: розбирач::Місцезнаходження,
    вихід_помилки: **Помилка,
  ) -> логічне {
    змінна успіх = ні;

    змінна обʼєкт_значення_умови: ОбʼєктЗначення;

    успіх = скомпілювати_значення_як_значення(
      компілятор,
      контекст,
      дані_якщо.умова,
      компілятор.тип_логічне,
      обʼєкт_значення_умови::адреса,
      вихід_помилки
    );
    якщо не успіх {
      вернути ні;
    }

    змінна оз_аргумента_нуль: ОбʼєктЗначення;

    якщо обʼєкт_значення_умови.тип == компілятор.тип_логічне {
      оз_аргумента_нуль = компілятор.ОЗ_логічне(ні);
    } інакше якщо обʼєкт_значення_умови.тип == компілятор.тип_ц8 {
      оз_аргумента_нуль = компілятор.ОЗ_ц8(0);
    } інакше якщо обʼєкт_значення_умови.тип == компілятор.тип_ц16 {
      оз_аргумента_нуль = компілятор.ОЗ_ц16(0);
    } інакше якщо обʼєкт_значення_умови.тип == компілятор.тип_ц32 {
      оз_аргумента_нуль = компілятор.ОЗ_ц32(0);
    } інакше якщо обʼєкт_значення_умови.тип == компілятор.тип_ц64 {
      оз_аргумента_нуль = компілятор.ОЗ_ц64(0);
    } інакше якщо обʼєкт_значення_умови.тип == компілятор.тип_п8 {
      оз_аргумента_нуль = компілятор.ОЗ_п8(0);
    } інакше якщо обʼєкт_значення_умови.тип == компілятор.тип_п16 {
      оз_аргумента_нуль = компілятор.ОЗ_п16(0);
    } інакше якщо обʼєкт_значення_умови.тип == компілятор.тип_п32 {
      оз_аргумента_нуль = компілятор.ОЗ_п32(0);
    } інакше якщо обʼєкт_значення_умови.тип == компілятор.тип_п64 {
      оз_аргумента_нуль = компілятор.ОЗ_п64(0);
    } інакше якщо обʼєкт_значення_умови.тип == компілятор.тип_р32 {
      оз_аргумента_нуль = компілятор.ОЗ_р32(0.0);
    } інакше якщо обʼєкт_значення_умови.тип == компілятор.тип_р64 {
      оз_аргумента_нуль = компілятор.ОЗ_р64(0.0);
    } інакше {
      вихід_помилки::вміст = створити_помилку(
        компілятор,
        "Умова має бути логічним.",
        створити_місцезнаходження_помилки_з_місцезнаходження_розбирача(компілятор, контекст.розібраний_текст, дані_якщо.умова.місцезнаходження)
      );
      вернути ні;
    }

    змінна аргумент_нуль = Аргумент {
      Обʼєкт { ВидОбʼєктаЗначення, оз_аргумента_нуль },
      місцезнаходження
    };

    змінна обʼєкт_рівно: Обʼєкт;

    успіх = обʼєкт_значення_не_рівно(
      компілятор,
      контекст,
      місцезнаходження,
      обʼєкт_значення_умови,
      аргумент_нуль,
      обʼєкт_рівно::адреса,
      вихід_помилки
    );
    якщо не успіх {
      вернути ні;
    }

    успіх = отримати_як_значення(
      компілятор,
      контекст,
      місцезнаходження,
      обʼєкт_рівно,
      компілятор.тип_логічне,
      обʼєкт_значення_умови::адреса,
      вихід_помилки
    );
    якщо не успіх {
      вернути ні;
    }

    якщо обʼєкт_значення_умови.тип != компілятор.тип_логічне {
      вихід_помилки::вміст = створити_помилку(
        компілятор,
        "Умова має бути логічним.",
        створити_місцезнаходження_помилки_з_місцезнаходження_розбирача(компілятор, контекст.розібраний_текст, дані_якщо.умова.місцезнаходження)
      );
      вернути ні;
    }

    змінна пм_крок_тіла_якщо = ПМ::створити_крок(контекст.кк_дії.обʼєкт_дії.пм_інструкція, отримати_назву(компілятор, "тіло_якщо"));
    змінна пм_крок_тіла_інакше = ПМ::створити_крок(контекст.кк_дії.обʼєкт_дії.пм_інструкція, отримати_назву(компілятор, "тіло_інакше"));
    змінна пм_крок_виходу_з_тіла_якщо = ПМ::створити_крок(контекст.кк_дії.обʼєкт_дії.пм_інструкція, отримати_назву(компілятор, "тіло_якщо_вихід"));

    ПМ::вказівка_СтрбЯкщо(контекст.кк_дії.поточний_крок.пм_крок, обʼєкт_значення_умови.пм_значення, пм_крок_тіла_якщо, пм_крок_тіла_інакше);

    змінна середовище_якщо = створити_середовище(компілятор, контекст.середовище);

    контекст.кк_дії.поточний_крок = Крок {
      отримати_назву(компілятор, "тіло_якщо"),
      контекст.кк_дії.обʼєкт_дії,
      пм_крок_тіла_якщо
    };

    успіх = скомпілювати_тіло(
      компілятор,
      Контекст {
        розібраний_текст = контекст.розібраний_текст,
        середовище = середовище_якщо,
        кк_дії = контекст.кк_дії
      },
      дані_якщо.тіло,
      місцезнаходження,
      вихід_помилки
    );

    якщо не успіх {
      вернути ні;
    }

    якщо ПМ::перевірити_чи_крок_закінчується_стрибком(контекст.кк_дії.поточний_крок.пм_крок) == ні {
      ПМ::вказівка_Стрб(контекст.кк_дії.поточний_крок.пм_крок, пм_крок_виходу_з_тіла_якщо);
    }

    змінна середовище_інакше = створити_середовище(компілятор, контекст.середовище);

    контекст.кк_дії.поточний_крок = Крок {
      отримати_назву(компілятор, "тіло_інакше"),
      контекст.кк_дії.обʼєкт_дії,
      пм_крок_тіла_інакше
    };

    успіх = скомпілювати_тіло(
      компілятор,
      Контекст {
        розібраний_текст = контекст.розібраний_текст,
        середовище = середовище_інакше,
        кк_дії = контекст.кк_дії
      },
      дані_якщо.тіло_інакше,
      місцезнаходження,
      вихід_помилки
    );

    якщо не успіх {
      вернути ні;
    }

    якщо ПМ::перевірити_чи_крок_закінчується_стрибком(контекст.кк_дії.поточний_крок.пм_крок) == ні {
      ПМ::вказівка_Стрб(контекст.кк_дії.поточний_крок.пм_крок, пм_крок_виходу_з_тіла_якщо);
    }

    контекст.кк_дії.поточний_крок = Крок {
      отримати_назву(компілятор, "тіло_якщо_вихід"),
      контекст.кк_дії.обʼєкт_дії,
      пм_крок_виходу_з_тіла_якщо
    };

    вернути так;
  }
}