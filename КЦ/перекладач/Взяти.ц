взяти визначення КЦ;

простір КЦ {
  дія скомпілювати_взяти(
    компілятор: *Компілятор,
    контекст: Контекст,
    дані_взяти: розбирач::ДаніСполукиВзяти,
    місцезнаходження: розбирач::Місцезнаходження,
    вихід_помилки: **Помилка
  ) -> логічне {
    змінна накопичувач_шляху_1 = зробити_накопичувач_шляху(компілятор);
    змінна накопичувач_шляху_2 = зробити_накопичувач_шляху(компілятор);
    змінна накопичувач_шляху_3 = зробити_накопичувач_шляху(компілятор);
    змінна накопичувач_шляху_4 = зробити_накопичувач_шляху(компілятор);

    змінна звідки = кд { пусто, 0 };

    якщо не розбирач::отримати_значення_слова(
      контекст.розібраний_текст.текст_коду.значення,
      контекст.розібраний_текст.слова.дані[дані_взяти.звідки.позиція_слова],
      звідки::адреса
    ) {
      вихід_помилки::вміст = створити_помилку(
        компілятор,
        "Не вдалось отримати значення слова для звідки.",
        створити_місцезнаходження_помилки_з_місцезнаходження_розбирача(компілятор, контекст.розібраний_текст, місцезнаходження)
      );
      вернути ні;
    }

    змінна директорія = біб::Шлях { 0, пусто, 0 };
    змінна директорію_треба_звільнити = ні;

    якщо біб::перевірити_чи_кд_рівні(звідки, "визначення") {
      якщо дані_взяти.відносно {
        змінна р = біб::зовнішній_шлях(контекст.розібраний_текст.текст_коду.шлях, директорія::адреса);
        якщо р < 0 {
          вихід_помилки::вміст = створити_помилку(
            компілятор,
            "Не вдалось отримати директорію шляху до файлу.",
            створити_місцезнаходження_помилки_з_місцезнаходження_розбирача(компілятор, контекст.розібраний_текст, місцезнаходження)
          );
          вернути ні;
        }
        директорію_треба_звільнити = так;
      } інакше {
        директорія = компілятор.кореневий_шлях;
      }
    } інакше якщо біб::перевірити_чи_кд_рівні(звідки, "біб") {
      якщо дані_взяти.відносно {
        вихід_помилки::вміст = створити_помилку(
          компілятор,
          "Неможливо взяти біб відносно.",
          створити_місцезнаходження_помилки_з_місцезнаходження_розбирача(компілятор, контекст.розібраний_текст, місцезнаходження)
        );
        вернути ні;
      }

      якщо компілятор.шлях_до_біб.розмір == 0 {
        якщо дані_взяти.відносно {
          вихід_помилки::вміст = створити_помилку(
            компілятор,
            "Шлях до біб не вказано.",
            створити_місцезнаходження_помилки_з_місцезнаходження_розбирача(компілятор, контекст.розібраний_текст, місцезнаходження)
          );
          вернути ні;
        }
      }

      директорія = компілятор.шлях_до_біб;
    }

    покласти_ю8_в_накопичувач_шляху(компілятор, накопичувач_шляху_1::адреса, ю8 { директорія.дані, директорія.розмір });
    покласти_кд_в_накопичувач_шляху(компілятор, накопичувач_шляху_1::адреса, "/");
    покласти_ю8_в_накопичувач_шляху(компілятор, накопичувач_шляху_2::адреса, ю8 { директорія.дані, директорія.розмір });
    покласти_кд_в_накопичувач_шляху(компілятор, накопичувач_шляху_2::адреса, "/");
    покласти_ю8_в_накопичувач_шляху(компілятор, накопичувач_шляху_3::адреса, ю8 { директорія.дані, директорія.розмір });
    покласти_кд_в_накопичувач_шляху(компілятор, накопичувач_шляху_3::адреса, "/");
    покласти_ю8_в_накопичувач_шляху(компілятор, накопичувач_шляху_4::адреса, ю8 { директорія.дані, директорія.розмір });
    покласти_кд_в_накопичувач_шляху(компілятор, накопичувач_шляху_4::адреса, "/визначення");
    покласти_кд_в_накопичувач_шляху(компілятор, накопичувач_шляху_4::адреса, "/");

    якщо директорію_треба_звільнити {
      біб::знищити_шлях(директорія);
    }

    змінна п: природне = 0;

    поки п < дані_взяти.шлях.розмір {
      змінна частина_кд = кд { пусто, 0 };

      якщо не розбирач::отримати_значення_слова(
        контекст.розібраний_текст.текст_коду.значення,
        контекст.розібраний_текст.слова.дані[дані_взяти.шлях.дані[п].позиція_слова],
        частина_кд::адреса
      ) {
        вихід_помилки::вміст = створити_помилку(
          компілятор,
          "Не вдалось отримати значення слова для частини шляху.",
          створити_місцезнаходження_помилки_з_місцезнаходження_розбирача(компілятор, контекст.розібраний_текст, місцезнаходження)
        );
        вернути ні;
      }

      покласти_кд_в_накопичувач_шляху(компілятор, накопичувач_шляху_1::адреса, частина_кд);
      покласти_кд_в_накопичувач_шляху(компілятор, накопичувач_шляху_2::адреса, частина_кд);
      покласти_кд_в_накопичувач_шляху(компілятор, накопичувач_шляху_3::адреса, частина_кд);
      покласти_кд_в_накопичувач_шляху(компілятор, накопичувач_шляху_4::адреса, частина_кд);

      якщо п != дані_взяти.шлях.розмір - 1 {
        покласти_кд_в_накопичувач_шляху(компілятор, накопичувач_шляху_1::адреса, "/");
        покласти_кд_в_накопичувач_шляху(компілятор, накопичувач_шляху_2::адреса, "/");
        покласти_кд_в_накопичувач_шляху(компілятор, накопичувач_шляху_3::адреса, "/");
        покласти_кд_в_накопичувач_шляху(компілятор, накопичувач_шляху_4::адреса, "/");
      }

      якщо п == дані_взяти.шлях.розмір - 1 {
        покласти_кд_в_накопичувач_шляху(компілятор, накопичувач_шляху_2::адреса, "/");
        покласти_кд_в_накопичувач_шляху(компілятор, накопичувач_шляху_2::адреса, частина_кд);
        покласти_кд_в_накопичувач_шляху(компілятор, накопичувач_шляху_3::адреса, "/");
        покласти_кд_в_накопичувач_шляху(компілятор, накопичувач_шляху_3::адреса, частина_кд);
      }

      п += 1;
    }

    покласти_кд_в_накопичувач_шляху(компілятор, накопичувач_шляху_1::адреса, ".в.ц");
    покласти_кд_в_накопичувач_шляху(компілятор, накопичувач_шляху_2::адреса, ".в.ц");
    покласти_кд_в_накопичувач_шляху(компілятор, накопичувач_шляху_3::адреса, ".в.ц");
    покласти_кд_в_накопичувач_шляху(компілятор, накопичувач_шляху_4::адреса, ".в.ц");

    змінна шлях_1: біб::Шлях;
    біб::шлях_з_ю8(ю8 { накопичувач_шляху_1.значення.дані, накопичувач_шляху_1.значення.розмір }, шлях_1::адреса);
    біб::звільнити(накопичувач_шляху_1.значення.дані);

    змінна шлях_2: біб::Шлях;
    біб::шлях_з_ю8(ю8 { накопичувач_шляху_2.значення.дані, накопичувач_шляху_2.значення.розмір }, шлях_2::адреса);
    біб::звільнити(накопичувач_шляху_2.значення.дані);

    змінна шлях_3: біб::Шлях;
    біб::шлях_з_ю8(ю8 { накопичувач_шляху_3.значення.дані, накопичувач_шляху_3.значення.розмір }, шлях_3::адреса);
    біб::звільнити(накопичувач_шляху_3.значення.дані);

    змінна шлях_4: біб::Шлях;
    біб::шлях_з_ю8(ю8 { накопичувач_шляху_4.значення.дані, накопичувач_шляху_4.значення.розмір }, шлях_4::адреса);
    біб::звільнити(накопичувач_шляху_4.значення.дані);

    змінна помилка: *Помилка = пусто;

    якщо біб::перевірити_чи_шлях_існує(шлях_1) {
      змінна абсолютний_шлях_1: біб::Шлях;

      біб::абсолютний_шлях(шлях_1, абсолютний_шлях_1::адреса);

      біб::знищити_шлях(шлях_1);
      біб::знищити_шлях(шлях_2);

      якщо не взяти_файл_ю8(компілятор, контекст.середовище, абсолютний_шлях_1, помилка::адреса) {
        біб::знищити_шлях(абсолютний_шлях_1);
        вихід_помилки::вміст = помилка;
        вернути ні;
      }
      біб::знищити_шлях(абсолютний_шлях_1);
    } інакше якщо біб::перевірити_чи_шлях_існує(шлях_2) {
      змінна абсолютний_шлях_2: біб::Шлях;

      біб::абсолютний_шлях(шлях_2, абсолютний_шлях_2::адреса);

      біб::знищити_шлях(шлях_1);
      біб::знищити_шлях(шлях_2);
      біб::знищити_шлях(шлях_3);
      біб::знищити_шлях(шлях_4);

      якщо не взяти_файл_ю8(компілятор, контекст.середовище, абсолютний_шлях_2, помилка::адреса) {
        біб::знищити_шлях(абсолютний_шлях_2);
        вихід_помилки::вміст = помилка;
        вернути ні;
      }
      біб::знищити_шлях(абсолютний_шлях_2);
    } інакше якщо біб::перевірити_чи_шлях_існує(шлях_3) {
      змінна абсолютний_шлях_3: біб::Шлях;

      біб::абсолютний_шлях(шлях_3, абсолютний_шлях_3::адреса);

      біб::знищити_шлях(шлях_1);
      біб::знищити_шлях(шлях_2);
      біб::знищити_шлях(шлях_3);
      біб::знищити_шлях(шлях_4);

      якщо не взяти_файл_ю8(компілятор, контекст.середовище, абсолютний_шлях_3, помилка::адреса) {
        біб::знищити_шлях(абсолютний_шлях_3);
        вихід_помилки::вміст = помилка;
        вернути ні;
      }
      біб::знищити_шлях(абсолютний_шлях_3);
    } інакше якщо біб::перевірити_чи_шлях_існує(шлях_4) {
      змінна абсолютний_шлях_4: біб::Шлях;

      біб::абсолютний_шлях(шлях_4, абсолютний_шлях_4::адреса);

      біб::знищити_шлях(шлях_1);
      біб::знищити_шлях(шлях_2);
      біб::знищити_шлях(шлях_3);
      біб::знищити_шлях(шлях_4);

      якщо не взяти_файл_ю8(компілятор, контекст.середовище, абсолютний_шлях_4, помилка::адреса) {
        біб::знищити_шлях(абсолютний_шлях_4);
        вихід_помилки::вміст = помилка;
        вернути ні;
      }
      біб::знищити_шлях(абсолютний_шлях_4);
    } інакше {
      біб::знищити_шлях(шлях_1);
      біб::знищити_шлях(шлях_2);
      біб::знищити_шлях(шлях_3);
      біб::знищити_шлях(шлях_4);

      якщо біб::перевірити_чи_кд_рівні(звідки, "визначення") {
        якщо не дані_взяти.відносно {
          змінна п: природне = 0;

          поки п < компілятор.шляхи_до_визначень.розмір {
            змінна шлях_до_визначень = компілятор.шляхи_до_визначень.дані[п];

            змінна накопичувач_шляху_1 = зробити_накопичувач_шляху(компілятор);
            змінна накопичувач_шляху_2 = зробити_накопичувач_шляху(компілятор);

            покласти_в_накопичувач_шляху(компілятор, накопичувач_шляху_1::адреса, Шлях { шлях_до_визначень.розмір, шлях_до_визначень.дані });
            покласти_кд_в_накопичувач_шляху(компілятор, накопичувач_шляху_1::адреса, "/");

            покласти_в_накопичувач_шляху(компілятор, накопичувач_шляху_2::адреса, Шлях { шлях_до_визначень.розмір, шлях_до_визначень.дані });
            покласти_кд_в_накопичувач_шляху(компілятор, накопичувач_шляху_2::адреса, "/");

            змінна пп: природне = 0;

            поки пп < дані_взяти.шлях.розмір {
              змінна частина_кд = кд { пусто, 0 };

              якщо не розбирач::отримати_значення_слова(
                контекст.розібраний_текст.текст_коду.значення,
                контекст.розібраний_текст.слова.дані[дані_взяти.шлях.дані[пп].позиція_слова],
                частина_кд::адреса
              ) {
                вихід_помилки::вміст = створити_помилку(
                  компілятор,
                  "Не вдалось отримати значення слова для частини шляху.",
                  створити_місцезнаходження_помилки_з_місцезнаходження_розбирача(компілятор, контекст.розібраний_текст, місцезнаходження)
                );
                вернути ні;
              }

              покласти_кд_в_накопичувач_шляху(компілятор, накопичувач_шляху_1::адреса, частина_кд);
              покласти_кд_в_накопичувач_шляху(компілятор, накопичувач_шляху_2::адреса, частина_кд);

              якщо пп != дані_взяти.шлях.розмір - 1 {
                покласти_кд_в_накопичувач_шляху(компілятор, накопичувач_шляху_1::адреса, "/");
                покласти_кд_в_накопичувач_шляху(компілятор, накопичувач_шляху_2::адреса, "/");
              }

              якщо пп == дані_взяти.шлях.розмір - 1 {
                покласти_кд_в_накопичувач_шляху(компілятор, накопичувач_шляху_2::адреса, "/");
                покласти_кд_в_накопичувач_шляху(компілятор, накопичувач_шляху_2::адреса, частина_кд);
              }

              пп += 1;
            }

            покласти_кд_в_накопичувач_шляху(компілятор, накопичувач_шляху_1::адреса, ".в.ц");
            покласти_кд_в_накопичувач_шляху(компілятор, накопичувач_шляху_2::адреса, ".в.ц");

            змінна шлях_1: біб::Шлях;
            біб::шлях_з_ю8(ю8 { накопичувач_шляху_1.значення.дані, накопичувач_шляху_1.значення.розмір }, шлях_1::адреса);
            біб::звільнити(накопичувач_шляху_1.значення.дані);

            змінна шлях_2: біб::Шлях;
            біб::шлях_з_ю8(ю8 { накопичувач_шляху_2.значення.дані, накопичувач_шляху_2.значення.розмір }, шлях_2::адреса);
            біб::звільнити(накопичувач_шляху_2.значення.дані);

            якщо біб::перевірити_чи_шлях_існує(шлях_1) {
              змінна абсолютний_шлях_1: біб::Шлях;

              біб::абсолютний_шлях(шлях_1, абсолютний_шлях_1::адреса);

              біб::знищити_шлях(шлях_1);
              біб::знищити_шлях(шлях_2);

              якщо не взяти_файл_ю8(компілятор, контекст.середовище, абсолютний_шлях_1, помилка::адреса) {
                біб::знищити_шлях(абсолютний_шлях_1);
                вихід_помилки::вміст = помилка;
                вернути ні;
              }
              біб::знищити_шлях(абсолютний_шлях_1);

              вернути так;
            } інакше якщо біб::перевірити_чи_шлях_існує(шлях_2) {
              змінна абсолютний_шлях_2: біб::Шлях;

              біб::абсолютний_шлях(шлях_2, абсолютний_шлях_2::адреса);

              біб::знищити_шлях(шлях_1);
              біб::знищити_шлях(шлях_2);

              якщо не взяти_файл_ю8(компілятор, контекст.середовище, абсолютний_шлях_2, помилка::адреса) {
                біб::знищити_шлях(абсолютний_шлях_2);
                вихід_помилки::вміст = помилка;
                вернути ні;
              }
              біб::знищити_шлях(абсолютний_шлях_2);

              вернути так;
            }

            п += 1;
          }
        }
      }

      вихід_помилки::вміст = створити_помилку(
        компілятор,
        "Шлях взяття не існує.",
        створити_місцезнаходження_помилки_з_місцезнаходження_розбирача(компілятор, контекст.розібраний_текст, місцезнаходження)
      );
      вернути ні;
    }

    вернути так;
  }
