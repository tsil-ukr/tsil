    біб::шлях_з_ю8(ю8 { накопичувач_шляху_3.значення.розмір, накопичувач_шляху_3.значення.дані }, шлях_3::адреса);
    біб::звільнити(накопичувач_шляху_3.значення.дані);

    змінна шлях_4: біб::Шлях;
    біб::шлях_з_ю8(ю8 { накопичувач_шляху_4.значення.розмір, накопичувач_шляху_4.значення.дані }, шлях_4::адреса);
    біб::звільнити(накопичувач_шляху_4.значення.дані);

    змінна шлях_5: біб::Шлях;
    біб::шлях_з_ю8(ю8 { накопичувач_шляху_5.значення.розмір, накопичувач_шляху_5.значення.дані }, шлях_5::адреса);
    біб::звільнити(накопичувач_шляху_5.значення.дані);

    змінна помилка: адреса<Помилка> = пусто;

    якщо біб::перевірити_чи_шлях_існує(шлях_1) {
