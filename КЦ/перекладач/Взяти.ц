    покласти_кд_в_накопичувач_шляху(компілятор, накопичувач_шляху_2::адреса, ".в.ц");
    покласти_кд_в_накопичувач_шляху(компілятор, накопичувач_шляху_3::адреса, ".о.ц");
    покласти_кд_в_накопичувач_шляху(компілятор, накопичувач_шляху_4::адреса, ".о.ц");
    покласти_кд_в_накопичувач_шляху(компілятор, накопичувач_шляху_5::адреса, ".в.ц");

    змінна шлях_1: біб::Шлях;
    біб::шлях_з_ю8(ю8 { накопичувач_шляху_1.значення.розмір, накопичувач_шляху_1.значення.дані }, шлях_1::адреса);
    біб::звільнити(накопичувач_шляху_1.значення.дані);

    змінна шлях_2: біб::Шлях;
    біб::шлях_з_ю8(ю8 { накопичувач_шляху_2.значення.розмір, накопичувач_шляху_2.значення.дані }, шлях_2::адреса);
    біб::звільнити(накопичувач_шляху_2.значення.дані);

