взяти визначення КЦ;

простір КЦ {
  місцева дія скомпілювати_взяти(компілятор: адреса<Компілятор>, контекст: Контекст, дані_взяти: розбирач::ДаніСполукиВзяти, місцезнаходження: розбирач::Місцезнаходження) -> РезультатОбʼєкта {
    змінна накопичувач_шляху_1 = зробити_накопичувач_шляху(компілятор);
    змінна накопичувач_шляху_2 = зробити_накопичувач_шляху(компілятор);
    змінна накопичувач_шляху_3 = зробити_накопичувач_шляху(компілятор);
    змінна накопичувач_шляху_4 = зробити_накопичувач_шляху(компілятор);
    змінна накопичувач_шляху_5 = зробити_накопичувач_шляху(компілятор);

    змінна звідки = т8 { 0, пусто };
    
    якщо не розбирач::отримати_значення_слова(
      контекст.розібраний_текст.текст_коду.значення,
      контекст.розібраний_текст.слова.дані[дані_взяти.звідки.позиція_слова],
      звідки::адреса
    ) {
      вернути РезультатОбʼєкта {
        помилка = створити_помилку(
          компілятор,
          "Не вдалось отримати значення слова для звідки.",
          створити_місцезнаходження_помилки_з_місцезнаходження_розбирача(компілятор, контекст.розібраний_текст, місцезнаходження)
        ),
        ...
      };
    }

    змінна директорія = біб::Шлях { 0, пусто, 0 };
    змінна директорію_треба_звільнити = ні;

    якщо біб::перевірити_чи_т8_рівні(звідки, "визначення") {
      якщо дані_взяти.відносно {
        змінна р = біб::зовнішній_шлях(контекст.розібраний_текст.текст_коду.шлях, директорія::адреса);
        якщо р < 0 {
          вернути РезультатОбʼєкта {
            помилка = створити_помилку(
              компілятор,
              "Не вдалось отримати директорію шляху до файлу.",
              створити_місцезнаходження_помилки_з_місцезнаходження_розбирача(компілятор, контекст.розібраний_текст, місцезнаходження)
            ),
            ...
          };
        }
        директорію_треба_звільнити = так;
      } інакше {
        директорія = компілятор.кореневий_шлях;
      }
    } інакше якщо біб::перевірити_чи_т8_рівні(звідки, "біб") {
      якщо дані_взяти.відносно {
        вернути РезультатОбʼєкта {
          помилка = створити_помилку(
            компілятор,
            "Неможливо взяти біб відносно.",
            створити_місцезнаходження_помилки_з_місцезнаходження_розбирача(компілятор, контекст.розібраний_текст, місцезнаходження)
          ),
          ...
        };
      }

      якщо компілятор.шлях_до_біб.розмір == 0 {
        якщо дані_взяти.відносно {
          вернути РезультатОбʼєкта {
            помилка = створити_помилку(
              компілятор,
              "Шлях до біб не вказано.",
              створити_місцезнаходження_помилки_з_місцезнаходження_розбирача(компілятор, контекст.розібраний_текст, місцезнаходження)
            ),
            ...
          };
        }
      }
      
      директорія = компілятор.шлях_до_біб;
    }

    покласти_ю8_в_накопичувач_шляху(компілятор, накопичувач_шляху_1::адреса, ю8 { директорія.розмір, директорія.дані });
    покласти_т8_в_накопичувач_шляху(компілятор, накопичувач_шляху_1::адреса, "/");
    покласти_ю8_в_накопичувач_шляху(компілятор, накопичувач_шляху_2::адреса, ю8 { директорія.розмір, директорія.дані });
    покласти_т8_в_накопичувач_шляху(компілятор, накопичувач_шляху_2::адреса, "/");
    покласти_ю8_в_накопичувач_шляху(компілятор, накопичувач_шляху_5::адреса, ю8 { директорія.розмір, директорія.дані });
    покласти_т8_в_накопичувач_шляху(компілятор, накопичувач_шляху_5::адреса, "/визначення");
    покласти_т8_в_накопичувач_шляху(компілятор, накопичувач_шляху_5::адреса, "/");
    
    якщо директорію_треба_звільнити {
      біб::знищити_шлях(директорія);
    }

    змінна п: природне = 0;

    поки п < дані_взяти.шлях.розмір {
      змінна частина_т8 = т8 { 0, пусто };
      
      якщо не розбирач::отримати_значення_слова(
        контекст.розібраний_текст.текст_коду.значення,
        контекст.розібраний_текст.слова.дані[дані_взяти.шлях.дані[п].позиція_слова],
        частина_т8::адреса
      ) {
        вернути РезультатОбʼєкта {
          помилка = створити_помилку(
            компілятор,
            "Не вдалось отримати значення слова для частини шляху.",
            створити_місцезнаходження_помилки_з_місцезнаходження_розбирача(компілятор, контекст.розібраний_текст, місцезнаходження)
          ),
          ...
        };
      }

      покласти_т8_в_накопичувач_шляху(компілятор, накопичувач_шляху_1::адреса, частина_т8);
      покласти_т8_в_накопичувач_шляху(компілятор, накопичувач_шляху_2::адреса, частина_т8);
      покласти_т8_в_накопичувач_шляху(компілятор, накопичувач_шляху_5::адреса, частина_т8);

      якщо п != дані_взяти.шлях.розмір - 1 {
        покласти_т8_в_накопичувач_шляху(компілятор, накопичувач_шляху_1::адреса, "/");
        покласти_т8_в_накопичувач_шляху(компілятор, накопичувач_шляху_2::адреса, "/");
        покласти_т8_в_накопичувач_шляху(компілятор, накопичувач_шляху_5::адреса, "/");
      }

      якщо п == дані_взяти.шлях.розмір - 1 {
        покласти_т8_в_накопичувач_шляху(компілятор, накопичувач_шляху_2::адреса, "/");
        покласти_т8_в_накопичувач_шляху(компілятор, накопичувач_шляху_2::адреса, частина_т8);
      }

      п += 1;
    }

    покласти_т8_в_накопичувач_шляху(компілятор, накопичувач_шляху_1::адреса, ".в.ц");
    покласти_т8_в_накопичувач_шляху(компілятор, накопичувач_шляху_2::адреса, ".в.ц");
    покласти_т8_в_накопичувач_шляху(компілятор, накопичувач_шляху_5::адреса, ".в.ц");

    змінна шлях_1: біб::Шлях; 
    біб::шлях_з_ю8(ю8 { накопичувач_шляху_1.значення.розмір, накопичувач_шляху_1.значення.дані }, шлях_1::адреса);
    біб::звільнити_памʼять(накопичувач_шляху_1.значення.дані);
    
    змінна шлях_2: біб::Шлях;
    біб::шлях_з_ю8(ю8 { накопичувач_шляху_2.значення.розмір, накопичувач_шляху_2.значення.дані }, шлях_2::адреса);
    біб::звільнити_памʼять(накопичувач_шляху_2.значення.дані);
    
    змінна шлях_5: біб::Шлях;
    біб::шлях_з_ю8(ю8 { накопичувач_шляху_5.значення.розмір, накопичувач_шляху_5.значення.дані }, шлях_5::адреса);
    біб::звільнити_памʼять(накопичувач_шляху_5.значення.дані);
    
    змінна помилка: адреса<Помилка> = пусто;

    якщо біб::перевірити_чи_шлях_існує(шлях_1) {
      змінна абсолютний_шлях_1: біб::Шлях;

      біб::абсолютний_шлях(шлях_1, абсолютний_шлях_1::адреса);

      біб::знищити_шлях(шлях_1);
      біб::знищити_шлях(шлях_2);
      біб::знищити_шлях(шлях_5);

      якщо не взяти_файл_ю8(компілятор, контекст.середовище, абсолютний_шлях_1, помилка::адреса) {
        біб::знищити_шлях(абсолютний_шлях_1);
        вернути РезультатОбʼєкта { помилка = помилка, ... };
      }
      біб::знищити_шлях(абсолютний_шлях_1);
    } інакше якщо біб::перевірити_чи_шлях_існує(шлях_2) {
      змінна абсолютний_шлях_2: біб::Шлях;

      біб::абсолютний_шлях(шлях_2, абсолютний_шлях_2::адреса);

      біб::знищити_шлях(шлях_1);
      біб::знищити_шлях(шлях_2);
      біб::знищити_шлях(шлях_5);

      якщо взяти_файл_ю8(компілятор, контекст.середовище, абсолютний_шлях_2, помилка::адреса) == ні {
        біб::знищити_шлях(абсолютний_шлях_2);
        вернути РезультатОбʼєкта { помилка = помилка, ... };
      }
      біб::знищити_шлях(абсолютний_шлях_2);
    } інакше якщо біб::перевірити_чи_шлях_існує(шлях_5) {
      змінна абсолютний_шлях_5: біб::Шлях;

      біб::абсолютний_шлях(шлях_5, абсолютний_шлях_5::адреса);

      біб::знищити_шлях(шлях_1);
      біб::знищити_шлях(шлях_2);
      біб::знищити_шлях(шлях_5);

      якщо взяти_файл_ю8(компілятор, контекст.середовище, абсолютний_шлях_5, помилка::адреса) == ні {
        біб::знищити_шлях(абсолютний_шлях_5);
        вернути РезультатОбʼєкта { помилка = помилка, ... };
      }
      біб::знищити_шлях(абсолютний_шлях_5);
    } інакше {
      біб::знищити_шлях(шлях_1);
      біб::знищити_шлях(шлях_2);
      біб::знищити_шлях(шлях_5);

      вернути РезультатОбʼєкта {
        помилка = створити_помилку(
          компілятор,
          "Шлях взяття не існує.",
          створити_місцезнаходження_помилки_з_місцезнаходження_розбирача(компілятор, контекст.розібраний_текст, місцезнаходження)
        ),
        ...
      };
    }

    вернути РезультатОбʼєкта { помилка = пусто, ... };
  }
}