    покласти_кд_в_накопичувач_шляху(компілятор, накопичувач_шляху_4::адреса, "/означення");
    покласти_кд_в_накопичувач_шляху(компілятор, накопичувач_шляху_4::адреса, "/");
    покласти_ю8_в_накопичувач_шляху(компілятор, накопичувач_шляху_5::адреса, ю8 { директорія.розмір, директорія.дані });
