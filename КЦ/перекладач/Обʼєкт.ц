взяти визначення КЦ;

простір КЦ {
  дія скомпілювати_обʼєкт(компілятор: *Компілятор, контекст: Контекст, дані_обʼєкта: розбирач::ДаніСполукиОбʼєкт, місцезнаходження: розбирач::Місцезнаходження, очікуваний_тип: *ОбʼєктТипу, вихід: *Обʼєкт, вихід_помилки: **Помилка) -> логічне {
    змінна успіх = ні;
    змінна помилка: *Помилка;
    змінна рез_обʼєкт_значення: ОбʼєктЗначення;
    змінна обʼєкт_типу = очікуваний_тип;

    якщо дані_обʼєкта.ліво != пусто {
      успіх = скомпілювати_значення_як_тип(
        компілятор,
        контекст,
        дані_обʼєкта.ліво,
        так,
        обʼєкт_типу::адреса,
        помилка::адреса
      );
      якщо не успіх {
        вихід_помилки::вміст = помилка;
        вернути ні;
      }
    }

    якщо обʼєкт_типу.вид != ВидОбʼєктаТипуСтруктура {
      вихід_помилки::вміст = створити_помилку(
        компілятор,
        "Неможливо скомпілювати обʼєкт.",
        створити_місцезнаходження_помилки_з_місцезнаходження_розбирача(компілятор, контекст.розібраний_текст, місцезнаходження)
      );
      вернути ні;
    };

    змінна дані_структури = обʼєкт_типу.дані як ДаніОбʼєктаТипуСтруктура;

    якщо контекст.кк_дії == пусто {
      змінна кількість_аргументів = дані_структури.параметри.розмір;
      змінна аргументи = біб::виділити<*ПМ::Значення>(дані_структури.параметри.розмір);
      змінна п: природне = 0;

      змінна заповнені_параметри = біб::виділити<п8>(дані_структури.параметри.розмір);
      поки п < дані_структури.параметри.розмір {
        заповнені_параметри[п] = 0;
        п += 1;
      }

      п = 0;

      поки п < дані_обʼєкта.аргументи.розмір {
        змінна аргумент = дані_обʼєкта.аргументи.дані[п];

        змінна знайдено_параметр = ні;
        змінна параметр: Параметр;
        змінна позиція_параметра: природне = 0;

        якщо аргумент.ідентифікатор.заповнено {
          змінна назва_кд = кд { пусто, 0 };

          якщо не розбирач::отримати_значення_слова(
            контекст.розібраний_текст.текст_коду.значення,
            контекст.розібраний_текст.слова.дані[аргумент.ідентифікатор.значення.позиція_слова],
            назва_кд::адреса
          ) {
            біб::звільнити(аргументи);
            біб::звільнити(заповнені_параметри);

            вихід_помилки::вміст = створити_помилку(
              компілятор,
              "Не вдалось отримати назву параметра.",
              створити_місцезнаходження_помилки_з_позиції_слова(компілятор, контекст.розібраний_текст, аргумент.ідентифікатор.значення.позиція_слова)
            );
            вернути ні;
          }

          змінна назва = отримати_назву(компілятор, назва_кд);

          змінна пп: природне = 0;

          поки пп < дані_структури.параметри.розмір {
            якщо назва == дані_структури.параметри.дані[пп].назва {
              знайдено_параметр = так;
              параметр = дані_структури.параметри.дані[пп];
              позиція_параметра = пп;
            }

            пп += 1;
          }
        } інакше якщо дані_структури.параметри.розмір > п {
          знайдено_параметр = так;
          параметр = дані_структури.параметри.дані[п];
          позиція_параметра = п;
        }

        якщо знайдено_параметр {
          заповнені_параметри[позиція_параметра] = 1;

          успіх = скомпілювати_значення_як_значення(
            компілятор,
            контекст,
            аргумент.значення,
            параметр.тип,
            рез_обʼєкт_значення::адреса,
            помилка::адреса
          );
          якщо не успіх {
            біб::звільнити(аргументи);
            біб::звільнити(заповнені_параметри);
            вихід_помилки::вміст = помилка;
        вернути ні;
          }

          якщо перевірити_тип_на_запис_і_конвертувати_якщо_треба(компілятор, параметр.тип, рез_обʼєкт_значення::адреса) == ні {
            біб::звільнити(аргументи);
            біб::звільнити(заповнені_параметри);

            вихід_помилки::вміст = створити_помилку_невірний_тип_значення(
              компілятор,
              Місцезнаходження { контекст.розібраний_текст, аргумент.значення.місцезнаходження.позиція_початкового_слова },
              параметр.тип,
              рез_обʼєкт_значення.тип
            );
            вернути ні;
          }

          аргументи[позиція_параметра] = рез_обʼєкт_значення.пм_значення;
        } інакше {
          якщо аргумент.ідентифікатор.заповнено {
            біб::звільнити(аргументи);
            біб::звільнити(заповнені_параметри);

            вихід_помилки::вміст = створити_помилку(
              компілятор,
              "Неочікуваний аргумент.",
              створити_місцезнаходження_помилки_з_позиції_слова(компілятор, контекст.розібраний_текст, аргумент.ідентифікатор.значення.позиція_слова)
            );
            вернути ні;
          } інакше {
            біб::звільнити(аргументи);
            біб::звільнити(заповнені_параметри);

            вихід_помилки::вміст = створити_помилку(
              компілятор,
              "Неочікуваний аргумент.",
              створити_місцезнаходження_помилки_з_місцезнаходження_розбирача(компілятор, контекст.розібраний_текст, аргумент.значення.місцезнаходження)
            );
            вернути ні;
          }
        }

        п += 1;
      }

      п = 0;

      біб::звільнити(заповнені_параметри);

      змінна пм_значення = ПМ::створити_обʼєкт(
        компілятор.пм_модуль,
        обʼєкт_типу.пм_тип,
        кількість_аргументів,
        аргументи
      );

      вихід::вміст = Обʼєкт { ВидОбʼєктаЗначення, ОбʼєктЗначення { обʼєкт_типу, пм_значення } };
      вернути так;
    } інакше {
      змінна пм_значення = ПМ::вказівка_виділити(
        контекст.кк_дії.крок_накопичень.пм_крок,
        обʼєкт_типу.пм_тип
      );

      змінна п: природне = 0;

      змінна заповнені_параметри = біб::виділити<п8>(дані_структури.параметри.розмір);
      поки п < дані_структури.параметри.розмір {
        заповнені_параметри[п] = 0;
        п += 1;
      }

      п = 0;

      поки п < дані_обʼєкта.аргументи.розмір {
        змінна аргумент = дані_обʼєкта.аргументи.дані[п];

        змінна знайдено_параметр = ні;
        змінна параметр: Параметр;
        змінна позиція_параметра: природне = 0;

        якщо аргумент.ідентифікатор.заповнено {
          змінна назва_кд = кд { пусто, 0 };

          якщо не розбирач::отримати_значення_слова(
            контекст.розібраний_текст.текст_коду.значення,
            контекст.розібраний_текст.слова.дані[аргумент.ідентифікатор.значення.позиція_слова],
            назва_кд::адреса
          ) {
            біб::звільнити(заповнені_параметри);

            вихід_помилки::вміст = створити_помилку(
              компілятор,
              "Не вдалось отримати назву параметра.",
              створити_місцезнаходження_помилки_з_позиції_слова(компілятор, контекст.розібраний_текст, аргумент.ідентифікатор.значення.позиція_слова)
            );
            вернути ні;
          }

          змінна назва = отримати_назву(компілятор, назва_кд);

          змінна пп: природне = 0;

          поки пп < дані_структури.параметри.розмір {
            якщо назва == дані_структури.параметри.дані[пп].назва {
              знайдено_параметр = так;
              параметр = дані_структури.параметри.дані[пп];
              позиція_параметра = пп;
            }

            пп += 1;
          }
        } інакше якщо дані_структури.параметри.розмір > п {
          знайдено_параметр = так;
          параметр = дані_структури.параметри.дані[п];
          позиція_параметра = п;
        }

        якщо знайдено_параметр {
          заповнені_параметри[позиція_параметра] = 1;

          успіх = скомпілювати_значення_як_значення(
            компілятор,
            контекст,
            аргумент.значення,
            параметр.тип,
            рез_обʼєкт_значення::адреса,
            помилка::адреса
          );
          якщо не успіх {
            біб::звільнити(заповнені_параметри);
            вихід_помилки::вміст = помилка;
        вернути ні;
          }

          якщо перевірити_тип_на_запис_і_конвертувати_якщо_треба(компілятор, параметр.тип, рез_обʼєкт_значення::адреса) == ні {
            біб::звільнити(заповнені_параметри);

            вихід_помилки::вміст = створити_помилку_невірний_тип_значення(
              компілятор,
              Місцезнаходження { контекст.розібраний_текст, аргумент.значення.місцезнаходження.позиція_початкового_слова },
              параметр.тип,
              рез_обʼєкт_значення.тип
            );
            вернути ні;
          }

          змінна пм_позиції_аргумента = біб::виділити<*ПМ::Значення>(2);
          пм_позиції_аргумента[0] = ПМ::створити_п32(компілятор.пм_модуль, 0);
          пм_позиції_аргумента[1] = ПМ::створити_п32(компілятор.пм_модуль, п32(позиція_параметра));
          змінна пм_значення_аргумента = ПМ::вказівка_отримати_адресу_елемента(
            контекст.кк_дії.поточний_крок.пм_крок,
            обʼєкт_типу.пм_тип,
            пм_значення,
            2,
            пм_позиції_аргумента
          );

          біб::звільнити(пм_позиції_аргумента);

          ПМ::вказівка_записати(
            контекст.кк_дії.поточний_крок.пм_крок,
            рез_обʼєкт_значення.пм_значення,
            пм_значення_аргумента
          );
        } інакше {
          якщо аргумент.ідентифікатор.заповнено {
            біб::звільнити(заповнені_параметри);

            вихід_помилки::вміст = створити_помилку(
              компілятор,
              "Неочікуваний аргумент.",
              створити_місцезнаходження_помилки_з_позиції_слова(компілятор, контекст.розібраний_текст, аргумент.ідентифікатор.значення.позиція_слова)
            );
            вернути ні;
          } інакше {
            біб::звільнити(заповнені_параметри);

            вихід_помилки::вміст = створити_помилку(
              компілятор,
              "Неочікуваний аргумент.",
              створити_місцезнаходження_помилки_з_місцезнаходження_розбирача(компілятор, контекст.розібраний_текст, аргумент.значення.місцезнаходження)
            );
            вернути ні;
          }
        }

        п += 1;
      }

      п = 0;

      якщо не дані_обʼєкта.аргументи.автозаповнити {
        поки п < дані_структури.параметри.розмір {
          якщо заповнені_параметри[п] == 0 {
            біб::звільнити(заповнені_параметри);

            вихід_помилки::вміст = створити_помилку(
              компілятор,
              "Пропущено аргумент.",
              створити_місцезнаходження_помилки_з_місцезнаходження_розбирача(компілятор, контекст.розібраний_текст, місцезнаходження)
            );
            вернути ні;
          }

          п += 1;
        }
      }

      біб::звільнити(заповнені_параметри);

      вихід::вміст = Обʼєкт { ВидОбʼєктаНезавантаженеЗначення, ОбʼєктНезавантаженогоЗначення { обʼєкт_типу, пм_значення } };
      вернути так;
    }
  }
}