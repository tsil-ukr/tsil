взяти визначення КЦ;

простір КЦ {
  дія скомпілювати_визначити_змінну(
    компілятор: *Компілятор,
    контекст: Контекст,
    дані_змінної: розбирач::ДаніСполукиЗмінна,
    місцезнаходження: розбирач::Місцезнаходження,
    вихід_помилки: **Помилка,
  ) -> логічне {
    змінна успіх = ні;
    змінна назва_кд = кд { пусто, 0 };

    якщо не розбирач::отримати_значення_слова(
      контекст.розібраний_текст.текст_коду.значення,
      контекст.розібраний_текст.слова.дані[дані_змінної.ідентифікатор.позиція_слова],
      назва_кд::адреса
    ) {
      вихід_помилки::вміст = створити_помилку(
        компілятор,
        "Не вдалось отримати назву змінної.",
        створити_місцезнаходження_помилки_з_місцезнаходження_розбирача(компілятор, контекст.розібраний_текст, місцезнаходження)
      );
      вернути ні;
    }

    змінна назва = отримати_назву(компілятор, назва_кд);

    змінна обʼєкт_з_середовища: Обʼєкт;
    якщо знайти_в_середовищі(контекст.середовище, назва, обʼєкт_з_середовища::адреса) {
      вихід_помилки::вміст = створити_помилку(
        компілятор,
        "Субʼєкт вже визначено.",
        створити_місцезнаходження_помилки_з_позиції_слова(компілятор, контекст.розібраний_текст, дані_змінної.ідентифікатор.позиція_слова)
      );
      вернути ні;
    }

    змінна обʼєкт: Обʼєкт;
    змінна обʼєкт_типу: *ОбʼєктТипу = пусто;

    якщо дані_змінної.тип != пусто {
      успіх = скомпілювати_значення_як_тип(
        компілятор,
        контекст,
        дані_змінної.тип,
        так,
        обʼєкт_типу::адреса,
        вихід_помилки
      );
      якщо не успіх {
        вернути ні;
      }
    }

    якщо контекст.кк_дії == пусто {
      змінна пм_видимість: природне;
      якщо дані_змінної.видимість == розбирач::ВИДИМІСТЬ_ВНУТРІШНЯ {
        пм_видимість = ПМ::ВИДИМІСТЬ_ВНУТРІШНЯ;
      } інакше якщо дані_змінної.видимість == розбирач::ВИДИМІСТЬ_ЗОВНІШНЯ {
        пм_видимість = ПМ::ВИДИМІСТЬ_ЗОВНІШНЯ;
      } інакше {
        вихід_помилки::вміст = створити_помилку(
          компілятор,
          "Глобальна змінна має мати вказану видимість.",
          створити_місцезнаходження_помилки_з_місцезнаходження_розбирача(компілятор, контекст.розібраний_текст, місцезнаходження)
        );
        вернути ні;
      }

      якщо дані_змінної.значення != пусто {
        вихід_помилки::вміст = створити_помилку(
          компілятор,
          "Глобальні змінні не можуть мати мати значення.",
          створити_місцезнаходження_помилки_з_позиції_слова(компілятор, контекст.розібраний_текст, дані_змінної.ідентифікатор.позиція_слова)
        );
        вернути ні;
      } інакше якщо обʼєкт_типу == пусто {
        вихід_помилки::вміст = створити_помилку(
          компілятор,
          "Глобальні змінні мають мати вказаний тип.",
          створити_місцезнаходження_помилки_з_позиції_слова(компілятор, контекст.розібраний_текст, дані_змінної.ідентифікатор.позиція_слова)
        );
        вернути ні;
      } інакше {
        змінна повна_назва = назва;

        якщо назва.значення.розмір > 0 {
          повна_назва = отримати_назву(компілятор, отримати_повну_назву_в_контексті(компілятор, контекст, назва.значення));
        }

        змінна пм_значення = ПМ::створити_глобальну(
          компілятор.пм_модуль,
          повна_назва,
          пм_видимість,
          обʼєкт_типу.пм_тип
        );

        обʼєкт = Обʼєкт {
          ВидОбʼєктаНезавантаженеЗначення,
          ОбʼєктНезавантаженогоЗначення {
            обʼєкт_типу,
            пм_значення
          }
        };
      }
    } інакше {
      якщо дані_змінної.видимість != розбирач::ВИДИМІСТЬ_НЕ_ВКАЗАНО {
        вихід_помилки::вміст = створити_помилку(
          компілятор,
          "Змінна в дії не може мати видимості.",
          створити_місцезнаходження_помилки_з_позиції_слова(компілятор, контекст.розібраний_текст, дані_змінної.ідентифікатор.позиція_слова)
        );
        вернути ні;
      }

      якщо дані_змінної.значення != пусто {
        змінна результат_значення = скомпілювати_значення_як_значення(компілятор, контекст, дані_змінної.значення, обʼєкт_типу);
        якщо результат_значення.помилка != пусто {
          вихід_помилки::вміст = результат_значення.помилка;
          вернути ні;
        }

        якщо обʼєкт_типу == пусто {
          обʼєкт_типу = результат_значення.обʼєкт_значення.тип;
        } інакше {
          якщо перевірити_тип_на_запис_і_конвертувати_якщо_треба(компілятор, обʼєкт_типу, результат_значення.обʼєкт_значення::адреса) == ні {
            вихід_помилки::вміст = створити_помилку_невірний_тип_значення(
              компілятор,
              Місцезнаходження { контекст.розібраний_текст, дані_змінної.значення.місцезнаходження.позиція_початкового_слова },
              обʼєкт_типу,
              результат_значення.обʼєкт_значення.тип
            );
            вернути ні;
          }
        }

        змінна пм_значення = ПМ::вказівка_виділити(контекст.кк_дії.крок_накопичень.пм_крок, обʼєкт_типу.пм_тип);
        обʼєкт = Обʼєкт {
          ВидОбʼєктаНезавантаженеЗначення,
          ОбʼєктНезавантаженогоЗначення {
            обʼєкт_типу,
            пм_значення
          }
        };

        ПМ::вказівка_записати(
          контекст.кк_дії.поточний_крок.пм_крок,
          результат_значення.обʼєкт_значення.пм_значення,
          пм_значення
        );
      } інакше якщо обʼєкт_типу == пусто {
        вихід_помилки::вміст = створити_помилку(
          компілятор,
          "Не вдалось скомпілювати змінну.",
          створити_місцезнаходження_помилки_з_позиції_слова(компілятор, контекст.розібраний_текст, дані_змінної.ідентифікатор.позиція_слова)
        );
        вернути ні;
      } інакше {
        змінна пм_значення = ПМ::вказівка_виділити(контекст.кк_дії.крок_накопичень.пм_крок, обʼєкт_типу.пм_тип);
        обʼєкт = Обʼєкт {
          ВидОбʼєктаНезавантаженеЗначення,
          ОбʼєктНезавантаженогоЗначення {
            обʼєкт_типу,
            пм_значення
          }
        };
      }
    }

    змінити_в_середовищі(
      контекст.середовище,
      назва,
      обʼєкт
    );

    вернути так;
  }
}