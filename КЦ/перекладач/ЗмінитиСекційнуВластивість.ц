взяти визначення КЦ;

простір КЦ {
  дія скомпілювати_змінити_секційну_властивість(
    компілятор: *Компілятор,
    контекст: Контекст,
    дані_змінити_секційну_властивість: розбирач::ДаніСполукиЗмінитиСекційнуВластивість,
    місцезнаходження: розбирач::Місцезнаходження,
    вихід: *Обʼєкт,
    вихід_помилки: **Помилка
  ) -> логічне {
    змінна успіх = ні;

    змінна обʼєкт_ліво: Обʼєкт;
    змінна обʼєкт_значення: Обʼєкт;

    успіх = скомпілювати_значення(
      компілятор,
      контекст,
      пусто,
      дані_змінити_секційну_властивість.ліво,
      пусто,
      обʼєкт_ліво::адреса,
      вихід_помилки
    );
    якщо не успіх {
      вернути ні;
    }

    успіх = скомпілювати_значення(
      компілятор,
      контекст,
      пусто,
      дані_змінити_секційну_властивість.значення,
      пусто,
      обʼєкт_значення::адреса,
      вихід_помилки
    );
    якщо не успіх {
      вернути ні;
    }

    змінна назва_кд = кд { пусто, 0 };

    якщо не розбирач::отримати_значення_ідентифікатора(
      контекст.розібраний_текст.текст_коду.значення,
      контекст.розібраний_текст.слова,
      дані_змінити_секційну_властивість.ідентифікатор,
      назва_кд::адреса
    ) {
      вихід_помилки::вміст = створити_помилку(
        компілятор,
        "Не вдалось отримати назву властивості секції.",
        створити_місцезнаходження_помилки_з_місцезнаходження_розбирача(компілятор, контекст.розібраний_текст, місцезнаходження)
      );
      вернути ні;
    }

    змінна назва = отримати_назву(компілятор, назва_кд);

    вернути обʼєкт_змінити_в_секції(
      компілятор,
      контекст,
      місцезнаходження,
      обʼєкт_ліво,
      назва,
      Аргумент { обʼєкт_значення, дані_змінити_секційну_властивість.значення.місцезнаходження },
      вихід,
      вихід_помилки
    );
  }
}