взяти визначення КЦ;

простір КЦ {
  дія скомпілювати_отримати_елемент(компілятор: *Компілятор, контекст: Контекст, дані_отримати_елемент: розбирач::ДаніСполукиОтриматиЕлемент, місцезнаходження: розбирач::Місцезнаходження, очікуваний_тип: *ОбʼєктТипу) -> РезультатОбʼєкта {
    змінна результат_ліво = скомпілювати_значення(компілятор, контекст, пусто, дані_отримати_елемент.ліво, пусто);
    якщо результат_ліво.помилка != пусто {
      вернути РезультатОбʼєкта { помилка = результат_ліво.помилка, ... };
    }

    змінна аргументи = біб::виділити<Аргумент>(
      дані_отримати_елемент.аргументи.розмір
    );

    змінна п: природне = 0;
    поки п < дані_отримати_елемент.аргументи.розмір {
      змінна результат_аргумента = скомпілювати_значення(
        компілятор,
        контекст,
        пусто,
        дані_отримати_елемент.аргументи.дані[п].значення,
        пусто
      );

      якщо результат_аргумента.помилка != пусто {
        біб::звільнити(аргументи);

        вернути РезультатОбʼєкта { помилка = результат_аргумента.помилка, ... };
      }

      аргументи[п] = Аргумент {
        обʼєкт = результат_аргумента.обʼєкт,
        місцезнаходження = дані_отримати_елемент.аргументи.дані[п].значення.місцезнаходження
      };

      п += 1;
    }

    змінна результат = обʼєкт_отримати_за_позицією(
      компілятор,
      контекст,
      місцезнаходження,
      результат_ліво.обʼєкт,
      дані_отримати_елемент.аргументи.розмір,
      аргументи,
      очікуваний_тип
    );

    вернути результат;
  }
}