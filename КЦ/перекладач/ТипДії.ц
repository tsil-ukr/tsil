взяти визначення КЦ;

простір КЦ {
  дія скомпілювати_тип_дії(
    компілятор: *Компілятор,
    контекст: Контекст,
    дані_типу_дії: розбирач::ДаніСполукиТипДії,
    місцезнаходження: розбирач::Місцезнаходження
  ) -> РезультатОбʼєктаТипу {
    змінна успіх = ні;
    змінна параметри: Параметри;
    змінна помилка: *Помилка;

    успіх = скомпілювати_параметри_дії(
      компілятор,
      контекст,
      пусто,
      дані_типу_дії.параметри,
      місцезнаходження,
      параметри::адреса,
      помилка::адреса
    );
    якщо не успіх {
      вернути РезультатОбʼєктаТипу::невдача(помилка);
    }

    змінна результат_типу = скомпілювати_значення_як_тип(компілятор, контекст, дані_типу_дії.тип_результату, так);
    якщо результат_типу.помилка != пусто {
      вернути РезультатОбʼєктаТипу::невдача(результат_типу.помилка);
    }

    змінна обʼєкт_типу = створити_тип_дії(
      компілятор,
      параметри,
      результат_типу.обʼєкт_типу
    );

    вернути РезультатОбʼєктаТипу::успіх(обʼєкт_типу);
  }
}