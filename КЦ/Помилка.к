  внутрішня дія видимість_дії_як_кд(видимість: природне) -> кд {
    якщо видимість == ВидимістьВнутрішня {
      вернути "внутрішня";
    }
    якщо видимість == ВидимістьЗовнішня {
      вернути "зовнішня";
    }
    вернути кд { 0, пусто };
  }

