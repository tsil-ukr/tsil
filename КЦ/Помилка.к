  дія створити_помилку_невірний_тип_вернути(компілятор: адреса<Компілятор>, місцезнаходження: Місцезнаходження, очікуваний_тип: адреса<ОбʼєктТипу>, тип: адреса<ОбʼєктТипу>) -> адреса<Помилка> {
    змінна накопичувач_кд = зробити_накопичувач_кд(компілятор);

    покласти_в_накопичувач_кд(компілятор, накопичувач_кд::адреса, "Невірний тип вернути: очікується \"");

    змінна назва_очікуваного_типу = отримати_повну_назву_типу(компілятор, очікуваний_тип);
    покласти_в_накопичувач_кд(компілятор, накопичувач_кд::адреса, назва_очікуваного_типу);
    біб::звільнити(назва_очікуваного_типу.дані);

    покласти_в_накопичувач_кд(компілятор, накопичувач_кд::адреса, "\", отримано \"");

    змінна назва_типу = отримати_повну_назву_типу(компілятор, тип);
    покласти_в_накопичувач_кд(компілятор, накопичувач_кд::адреса, назва_типу);
    біб::звільнити(назва_типу.дані);

    покласти_в_накопичувач_кд(компілятор, накопичувач_кд::адреса, "\".");

    вернути створити_помилку_без_копіювання(
      компілятор,
      накопичувач_кд.значення,
      створити_місцезнаходження_помилки_з_місцезнаходження(
        компілятор,
        місцезнаходження
      )
    );
  }

