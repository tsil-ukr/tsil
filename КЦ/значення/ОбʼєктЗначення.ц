простір КЦ {
  дія обʼєкт_значення_як(компілятор: *Компілятор, контекст: Контекст, місцезнаходження: розбирач::Місцезнаходження, обʼєкт_значення: ОбʼєктЗначення, аргумент: Аргумент) -> РезультатОбʼєкта {
    якщо аргумент.обʼєкт.вид != ВидОбʼєктаТип {
      вернути РезультатОбʼєкта::створити_помилку_місроз(компілятор, контекст.розібраний_текст, місцезнаходження, "Не вдалось скомпілювати");
    }

    змінна новий_тип = аргумент.обʼєкт.дані як *ОбʼєктТипу;
    якщо новий_тип == обʼєкт_значення.тип {
      вернути РезультатОбʼєкта { Обʼєкт { ВидОбʼєктаЗначення, дані = обʼєкт_значення }, помилка = пусто };
    }

    якщо обʼєкт_значення.тип.вид == ВидОбʼєктаТипуАдреса {
      якщо новий_тип.вид == ВидОбʼєктаТипуАдреса {
        обʼєкт_значення.тип = новий_тип;
        вернути РезультатОбʼєкта { Обʼєкт { ВидОбʼєктаЗначення, дані = обʼєкт_значення }, помилка = пусто };
      }
      якщо новий_тип.вид == ВидОбʼєктаТипуДія {
        // потім: перевірити чи це тип невідомої адреси
        обʼєкт_значення.тип = новий_тип;
        вернути РезультатОбʼєкта { Обʼєкт { ВидОбʼєктаЗначення, дані = обʼєкт_значення }, помилка = пусто };
      }
    }

    якщо обʼєкт_значення.тип.вид == ВидОбʼєктаТипуДія {
      // потім: перевірити тут тоже!!!
      якщо новий_тип.вид == ВидОбʼєктаТипуАдреса {
        обʼєкт_значення.тип = новий_тип;
        вернути РезультатОбʼєкта { Обʼєкт { ВидОбʼєктаЗначення, дані = обʼєкт_значення }, помилка = пусто };
      }
    }

    якщо обʼєкт_значення.тип.вид == ВидОбʼєктаТипуВаріація {
      змінна дані_варіації = обʼєкт_значення.тип.дані як ДаніОбʼєктаТипуВаріація;
      змінна знайдений_тип_варіації: *ОбʼєктТипу = пусто;
      змінна п: природне = 0;
      поки п < дані_варіації.кількість_типів {
        якщо перевірити_тип(компілятор, новий_тип, дані_варіації.типи[п]) {
          знайдений_тип_варіації = дані_варіації.типи[п];
        }
        п += 1;
      }
      якщо знайдений_тип_варіації == пусто {
        вернути РезультатОбʼєкта::створити_помилку_місроз(компілятор, контекст.розібраний_текст, місцезнаходження, "Не вдалось скомпілювати");
      }
      обʼєкт_значення.тип = знайдений_тип_варіації;
      обʼєкт_значення.пм_значення = ПМ::вказівка_як(контекст.кк_дії.поточний_крок.пм_крок, обʼєкт_значення.пм_значення, знайдений_тип_варіації.пм_тип);
      вернути РезультатОбʼєкта { Обʼєкт { ВидОбʼєктаЗначення, дані = обʼєкт_значення }, помилка = пусто };
    }

    вернути РезультатОбʼєкта::створити_помилку_місроз(компілятор, контекст.розібраний_текст, місцезнаходження, "Не вдалось скомпілювати");
  }
}

простір КЦ {
  дія обʼєкт_значення_отримати_властивість(компілятор: *Компілятор, контекст: Контекст, місцезнаходження: розбирач::Місцезнаходження, обʼєкт_значення: ОбʼєктЗначення, назва: *Назва, очікуваний_тип: *ОбʼєктТипу) -> РезультатОбʼєкта {
    якщо назва == отримати_назву(компілятор, "*") {
      якщо обʼєкт_значення.тип.вид == ВидОбʼєктаТипуАдреса {
        змінна дані_адреси = обʼєкт_значення.тип.дані як ДаніОбʼєктаТипуАдреса;
        змінна тип = дані_адреси.тип_даних;
        змінна пм_позиції = біб::виділити<*ПМ::Значення>(1);
        пм_позиції[0] = ПМ::створити_п32(компілятор.пм_модуль, 0);
        змінна пм_значення = ПМ::вказівка_отримати_адресу_елемента(
          контекст.кк_дії.поточний_крок.пм_крок,
          тип.пм_тип,
          обʼєкт_значення.пм_значення,
          1,
          пм_позиції
        );
        біб::звільнити(пм_позиції);
        змінна обʼєкт_незавантаженого_значення: ОбʼєктНезавантаженогоЗначення;
        обʼєкт_незавантаженого_значення.тип = тип;
        обʼєкт_незавантаженого_значення.пм_значення = пм_значення;
        вернути РезультатОбʼєкта { Обʼєкт { ВидОбʼєктаНезавантаженеЗначення, дані = обʼєкт_незавантаженого_значення }, помилка = пусто };
      } інакше {
        вернути РезультатОбʼєкта::створити_помилку_місроз(компілятор, контекст.розібраний_текст, місцезнаходження, "Не вдалось скомпілювати");
      }
    }

    змінна тип: *ОбʼєктТипу;
    змінна пм_значення: *ПМ::Значення;

    тип = обʼєкт_значення.тип;
    пм_значення = обʼєкт_значення.пм_значення;

    якщо тип.вид == ВидОбʼєктаТипуАдреса {
      змінна дані_адреси = тип.дані як ДаніОбʼєктаТипуАдреса;

      вернути обʼєкт_незавантаженого_значення_отримати_властивість(
        компілятор,
        контекст,
        місцезнаходження,
        ОбʼєктНезавантаженогоЗначення { дані_адреси.тип_даних, пм_значення },
        назва,
        очікуваний_тип
      );
    }

    якщо тип.вид != ВидОбʼєктаТипуСтруктура {
      вернути РезультатОбʼєкта::створити_помилку_місроз(компілятор, контекст.розібраний_текст, місцезнаходження, "Не вдалось скомпілювати");
    }

    змінна дані_структури = тип.дані як ДаніОбʼєктаТипуСтруктура;

    якщо дані_структури.дії != пусто {
      змінна обʼєкт_з_середовища: Обʼєкт;

      якщо знайти_в_середовищі(дані_структури.дії, назва, обʼєкт_з_середовища::адреса) {
        вернути РезультатОбʼєкта { обʼєкт_з_середовища, помилка = пусто };
      }
    }

    змінна позиція_знайденої_властивості: природне = 0;
    змінна властивість_структури: Параметр;
    змінна властивість_структури_знайдено: логічне = ні;

    змінна п: природне = 0;
    поки п < дані_структури.параметри.розмір {
      якщо дані_структури.параметри.дані[п].назва == назва {
        позиція_знайденої_властивості = п;
        властивість_структури = дані_структури.параметри.дані[п];
        властивість_структури_знайдено = так;
      }

      п += 1;
    }

    якщо властивість_структури_знайдено == ні {
      вернути РезультатОбʼєкта::створити_помилку_місроз(компілятор, контекст.розібраний_текст, місцезнаходження, "Не вдалось скомпілювати");
    }

    змінна пм_отримане_значення = ПМ::вказівка_отримати_значення(
      контекст.кк_дії.поточний_крок.пм_крок,
      пм_значення,
      позиція_знайденої_властивості
    );

    змінна обʼєкт_отриманого_значення: ОбʼєктЗначення;
    обʼєкт_отриманого_значення.тип = властивість_структури.тип;
    обʼєкт_отриманого_значення.пм_значення = пм_отримане_значення;

    вернути РезультатОбʼєкта { Обʼєкт { ВидОбʼєктаЗначення, дані = обʼєкт_отриманого_значення }, помилка = пусто };
  }
}

