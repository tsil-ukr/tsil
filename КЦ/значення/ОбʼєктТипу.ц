простір КЦ {
  дія обʼєкт_типу_отримати_властивість(компілятор: *Компілятор, контекст: Контекст, місцезнаходження: розбирач::Місцезнаходження, обʼєкт_типу: *ОбʼєктТипу, назва: *Назва, очікуваний_тип: *ОбʼєктТипу) -> РезультатОбʼєкта {
    якщо перевірити_чи_тип_повний(компілятор, обʼєкт_типу) == ні {
      вернути РезультатОбʼєкта::створити_помилку_місроз(компілятор, контекст.розібраний_текст, місцезнаходження, "Не вдалось скомпілювати");
    }

    якщо назва == отримати_назву(компілятор, "розмір") {
      змінна розмір_типу = дізнатись_розмір_типу(компілятор, обʼєкт_типу);

      змінна розмір_типу_як_кд = кд { пусто, 0 };

      якщо перетворити_природне_на_кд(компілятор, розмір_типу, розмір_типу_як_кд::адреса) == ні {
        вернути РезультатОбʼєкта::створити_помилку_місроз(компілятор, контекст.розібраний_текст, місцезнаходження, "Не вдалось скомпілювати");
      }

      змінна обʼєкт_сирого_значення = виділити_обʼєкт_сирого_значення(компілятор);
      обʼєкт_сирого_значення.дані = розмір_типу_як_кд;

      вернути РезультатОбʼєкта { Обʼєкт { ВидОбʼєктаСиреЗначення, дані = обʼєкт_сирого_значення }, помилка = пусто };
    }

    вернути РезультатОбʼєкта::створити_помилку_місроз(компілятор, контекст.розібраний_текст, місцезнаходження, "Не вдалось скомпілювати");
  }
}

простір КЦ {
  дія обʼєкт_типу_отримати_властивість_секції(компілятор: *Компілятор, контекст: Контекст, місцезнаходження: розбирач::Місцезнаходження, обʼєкт_типу: *ОбʼєктТипу, назва: *Назва, очікуваний_тип: *ОбʼєктТипу) -> РезультатОбʼєкта {
    якщо обʼєкт_типу.вид == ВидОбʼєктаТипуСтруктура {
      змінна дані = обʼєкт_типу.дані як ДаніОбʼєктаТипуСтруктура;

      якщо дані.дії != пусто {
        змінна обʼєкт_з_середовища: Обʼєкт;
        якщо знайти_в_середовищі(дані.дії, назва, обʼєкт_з_середовища::адреса) {
          вернути РезультатОбʼєкта { обʼєкт_з_середовища, помилка = пусто };
        }
