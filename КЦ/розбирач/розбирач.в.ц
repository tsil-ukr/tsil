    дія знищити_слова(розбирач: *Розбирач, слова: Слова);

    внутрішня дія отримати_значення_слова(значення: кд, слово: Слово, вихід: *кд) -> логічне {
      вихід::вміст = кд {
        розмір = (слово.позиція_кінця.позиція_в_тексті - слово.позиція_початку.позиція_в_тексті) + 1,
        дані = значення.дані[слово.позиція_початку.позиція_в_тексті]::адреса
      };

      вернути так;
    }

    внутрішня дія отримати_значення_тексту(значення: кд, слово: Слово, вихід: *кд) -> логічне {
      змінна значення_слова = кд { пусто, 0 };

      якщо не отримати_значення_слова(значення, слово, значення_слова::адреса) {
        вернути ні;
      }

      змінна розмір_нового_значення = значення_слова.розмір - 2;
      змінна дані_нового_значення = біб::виділити<п8>(розмір_нового_значення);

      змінна п: природне = 0;
      поки п < розмір_нового_значення {
        дані_нового_значення[п] = значення_слова.дані[п + 1];

        п += 1;
      }

      вихід::вміст = кд {
        дані_нового_значення,
        розмір_нового_значення,
      };

      біб::звільнити(значення_слова.дані);

      вернути так;
    }

