    внутрішня дія покласти_в_слова(розбирач: *Розбирач, слова: *Слова, слово: Слово) {
      якщо слова.розмір == слова.вмісткість {
        слова.вмісткість += 1;
        слова.дані = біб::перевиділити<Слово>(слова.дані, слова.вмісткість);
      }
      слова.дані[слова.розмір] = слово;
      слова.розмір += 1;
    }

