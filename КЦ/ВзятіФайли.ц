взяти визначення ./КЦ;

простір КЦ {
  внутрішня дія перед_заміною_в_реєстрі(реєстр: *біб::Реєстр<біб::Шлях, *РозібранийТекст>, ак: біб::Шлях, аз: *РозібранийТекст, бк: *біб::Шлях, бз: **РозібранийТекст) {
    змінна компілятор = реєстр.аргумент як *Компілятор;

    біб::знищити_шлях(ак);
  }

  внутрішня дія перед_видаленням_з_реєстру(реєстр: *біб::Реєстр<біб::Шлях, *РозібранийТекст>, ключ: біб::Шлях, значення: *РозібранийТекст) {
    змінна компілятор = реєстр.аргумент як *Компілятор;

    біб::знищити_шлях(ключ);
  }

  дія створити_взяті_файли(компілятор: *Компілятор) -> *ВзятіФайли {
    змінна взяті_файли = біб::виділити<ВзятіФайли>(1);

    взяті_файли.компілятор = компілятор;
    взяті_файли.реєстр = біб::виділити_реєстр<біб::Шлях, *РозібранийТекст>(
      0,
      компілятор,
      змішати_шлях_для_реєстру<*РозібранийТекст>,
      перевірити_шляхи_в_реєстрі<*РозібранийТекст>,
      перед_заміною_в_реєстрі,
      перед_видаленням_з_реєстру
    );

    вернути взяті_файли;
  }

  дія знищити_взяті_файли(взяті_файли: *ВзятіФайли) {
    змінна компілятор = взяті_файли.компілятор;

    біб::звільнити_реєстр<біб::Шлях, *РозібранийТекст>(взяті_файли.реєстр);

    біб::звільнити(взяті_файли);
  }

  дія покласти_взятий_файл(взяті_файли: *ВзятіФайли, шлях: біб::Шлях, розібраний_текст: *РозібранийТекст) {
    змінна компілятор = взяті_файли.компілятор;

    біб::клонувати_шлях(шлях, шлях::адреса);

    біб::змінити_в_реєстрі<біб::Шлях, *РозібранийТекст>(
      взяті_файли.реєстр,
      шлях,
      розібраний_текст
    );
  }

  дія знайти_взятий_файл(взяті_файли: *ВзятіФайли, шлях: біб::Шлях, вихід: **РозібранийТекст) -> логічне {
    вернути біб::знайти_в_реєстрі<біб::Шлях, *РозібранийТекст>(
      взяті_файли.реєстр,
      шлях,
      вихід
    );
  }
}