зовнішня дія __КЦ__кланг_лінк(вих: *біб::Шлях, кф: природне, сф: *біб::Шлях, кллвір: природне, сллвмір: *біб::Шлях) -> ц32;

дія ціль_зібрати(
  шлях_до_основи: біб::Шлях,
  шлях_до_мейн: біб::Шлях,
  опції_програми: цілеспрямовано::Опції<кд>,
  опції_команди: цілеспрямовано::Опції<кд>,
  входи: цілеспрямовано::ВходиКоманди<кд>,
  вихід: кд,
  опції_виходу: цілеспрямовано::Опції<кд>,
) -> ц32 {
  змінна кр = ц32(0);
  змінна п = природне(0);
  змінна вх_файли = біб::зробити_накопичувач<біб::Шлях>(0);
  змінна ллвмір_файли = біб::зробити_накопичувач<біб::Шлях>(0);

  біб::покласти_в_накопичувач<біб::Шлях>(вх_файли::адреса, шлях_до_мейн);

  поки п < входи.розмір {
    змінна вхід = входи.дані[0];

    змінна вихроз = ".ллвмір";

    змінна компвихід = кд {
      біб::виділити<п8>(вхід.значення.розмір + вихроз.розмір),
      вхід.значення.розмір + вихроз.розмір,
    };

    змінна пп = природне(0);

    поки пп < вхід.значення.розмір {
      компвихід.дані[пп] = вхід.значення.дані[пп];

      пп += 1;
    }

    пп = 0;
    поки пп < вихроз.розмір {
      компвихід.дані[вхід.значення.розмір + пп] = вихроз.дані[пп];

      пп += 1;
    }

    біб::вивести("ціль ");
    біб::вивести(компвихід);
    біб::вивести(" скомпілювати ");
    біб::надрукувати(вхід.значення);

    кр = ціль_скомпілювати(
      шлях_до_основи,
      опції_програми,
      опції_команди,
      вхід.значення,
      вхід.опції,
      компвихід,
      цілеспрямовано::Опції<кд> { 0, пусто },
      так,
    );

    якщо кр != 0 {
      вернути кр;
    }

    змінна вихшлях: біб::Шлях;

    якщо біб::шлях_з_тексту(компвихід, вихшлях::адреса) != 0 {
      біб::надрукувати("біб::шлях_з_тексту(компвихід, вихшлях::адреса) != 0");
      вернути 1;
    }

    біб::покласти_в_накопичувач<біб::Шлях>(ллвмір_файли::адреса, вихшлях);

    біб::звільнити(компвихід.дані);

    п += 1;
  }

  змінна вихшлях: біб::Шлях;

  якщо біб::шлях_з_тексту(вихід, вихшлях::адреса) != 0 {
    біб::надрукувати("біб::шлях_з_тексту(вихід, вихшлях::адреса) != 0");
    вернути 1;
  }

  кр = __КЦ__кланг_лінк(
    вихшлях::адреса,
    вх_файли.розмір,
    вх_файли.дані,
    ллвмір_файли.розмір,
    ллвмір_файли.дані
  );

  вернути кр;
}