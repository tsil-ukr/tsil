структура кд {
  дані: *п8;
  розмір: природне;

  внутрішня дія рівн_до(я: *Я, значення: кд) -> логічне {
    змінна розмір = я.розмір;
    змінна дані = я.дані;

    якщо розмір != значення.розмір {
      вернути ні;
    }

    змінна п: природне = 0;
    поки п < розмір {
      якщо дані[п] != значення.дані[п] {
        вернути ні;
      }

      п += 1;
    }

    вернути так;
  }

  внутрішня дія поч_з(я: *Я, значення: кд) -> логічне {
    змінна розмір = я.розмір;
    змінна дані = я.дані;

    якщо розмір < значення.розмір {
      вернути ні;
    }

    змінна п: природне = 0;
    поки п < значення.розмір {
      якщо дані[п] != значення.дані[п] {
        вернути ні;
      }

      п += 1;
    }

    вернути так;
  }


  внутрішня дія зак_на(я: *Я, значення: кд) -> логічне {
    змінна розмір = я.розмір;
    змінна дані = я.дані;

    якщо розмір < значення.розмір {
      вернути ні;
    }

    змінна п: природне = 0;
    поки п < значення.розмір {
      якщо дані[розмір - значення.розмір + п] != значення.дані[п] {
        вернути ні;
      }

      п += 1;
    }

    вернути так;
  }
}

